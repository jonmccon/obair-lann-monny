{%- css %}
/* ─── Resume page layout ─────────────────────────────── */

.resume-shell {
  max-width: 960px;
  margin: 0 auto;
  padding: 2rem var(--site-gutter);
}

/* ── Header: portrait + identity block ──────────────── */
.resume-header {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 1.75rem;
  align-items: center;
  margin-bottom: 2rem;
  padding-bottom: 1.5rem;
  border-bottom: 2px solid var(--anp-crust);
}

.resume-portrait-wrap {
  width: clamp(72px, 10vw, 120px);
  height: clamp(72px, 10vw, 120px);
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow: 0 2px 8px var(--shadow-color);
}

.resume-portrait-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.resume-identity {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}

.resume-name {
  font-size: clamp(1.4rem, 3.5vw, 2rem);
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--text-color);
  margin: 0;
  line-height: 1.15;
}

.resume-tagline {
  font-size: 0.9rem;
  color: var(--text-color-muted);
  margin: 0;
  line-height: 1.4;
  max-width: 52ch;
}

.resume-contact {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1.25rem;
  margin-top: 0.4rem;
  font-size: 0.82rem;
}

.resume-contact a {
  color: var(--text-color-link);
  text-decoration: none;
  font-weight: 500;
}

.resume-contact a:hover {
  color: var(--text-color-link-active);
  text-decoration: underline;
}

/* ── Clipboard button ───────────────────────────────── */
.resume-clipboard-bar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 1.5rem;
}

.btn-clipboard {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.35rem 0.9rem;
  font-size: 0.8rem;
  font-family: inherit;
  font-weight: 500;
  border: 1px dashed var(--color-gray-20);
  border-radius: 999px;
  background: transparent;
  color: var(--text-color-muted);
  cursor: pointer;
  transition: color 0.15s, border-color 0.15s;
}

.btn-clipboard:hover {
  color: var(--text-color-link-active);
  border-color: var(--text-color-link-active);
}

.btn-clipboard.copied {
  color: var(--anp-green);
  border-color: var(--anp-green);
}

/* ── Two-column body ─────────────────────────────────── */
.resume-body {
  display: grid;
  grid-template-columns: 1fr 0.42fr;
  gap: 0 2.5rem;
  align-items: start;
}

.resume-main-col {}
.resume-side-col {}

/* ── Section blocks ─────────────────────────────────── */
.resume-section {
  margin-bottom: 1.75rem;
}

.resume-section-label {
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--text-color-on-accent);
  background: var(--anp-text);
  padding: 0.18rem 0.55rem;
  display: inline-block;
  margin-bottom: 0.9rem;
}

/* ── Experience entries ─────────────────────────────── */
.resume-entry {
  margin-bottom: 1.25rem;
  padding-bottom: 1.1rem;
  border-bottom: 1px solid var(--anp-crust);
}

.resume-entry:last-child {
  border-bottom: none;
  margin-bottom: 0;
}

.resume-entry-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 0.5rem;
  flex-wrap: wrap;
  margin-bottom: 0.1rem;
}

.resume-entry-title {
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.01em;
  text-transform: uppercase;
  color: var(--text-color);
  margin: 0;
}

.resume-entry-dates {
  font-size: 0.78rem;
  color: var(--text-color-subtle);
  white-space: nowrap;
  flex-shrink: 0;
}

.resume-entry-org {
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--text-color);
  margin: 0 0 0.35rem;
}

.resume-entry-body {
  font-size: 0.8rem;
  color: var(--text-color-muted);
  line-height: 1.6;
  margin: 0;
}

.resume-entry-focus {
  font-size: 0.72rem;
  color: var(--text-color-subtle);
  margin-top: 0.35rem;
}

/* ── Summary ────────────────────────────────────────── */
.resume-summary p {
  font-size: 0.82rem;
  color: var(--text-color-muted);
  line-height: 1.7;
  margin: 0 0 0.65rem;
}

/* ── Skills grid ────────────────────────────────────── */
.resume-skills-group {
  margin-bottom: 0.85rem;
}

.resume-skills-group-name {
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-color-subtle);
  margin: 0 0 0.2rem;
}

.resume-skills-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.3rem;
}

.resume-skill-tag {
  font-size: 0.72rem;
  background: var(--surface-color-alt);
  color: var(--text-color-muted);
  padding: 0.12rem 0.45rem;
  border-radius: 3px;
}

/* ── Education entries ─────────────────────────────── */
.resume-edu-entry {
  margin-bottom: 0.9rem;
  padding-bottom: 0.85rem;
  border-bottom: 1px solid var(--anp-crust);
}

.resume-edu-entry:last-child {
  border-bottom: none;
  margin-bottom: 0;
}

.resume-edu-degree {
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.01em;
  color: var(--text-color);
  margin: 0;
}

.resume-edu-school {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--text-color);
  margin: 0.05rem 0;
}

.resume-edu-year {
  font-size: 0.74rem;
  color: var(--text-color-subtle);
}

/* ── Additional / short entries ────────────────────── */
.resume-short-entry {
  margin-bottom: 0.75rem;
  padding-bottom: 0.7rem;
  border-bottom: 1px solid var(--anp-crust);
}

.resume-short-entry:last-child {
  border-bottom: none;
}

/* ─── Mobile: single column ─────────────────────────── */
@media (max-width: 640px) {
  .resume-header {
    grid-template-columns: auto 1fr;
    gap: 1rem;
  }

  .resume-body {
    grid-template-columns: 1fr;
  }

  .resume-portrait-wrap {
    width: 64px;
    height: 64px;
  }
}
{% endcss %}

