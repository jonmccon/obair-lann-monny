{%- css %}
/* ─── Resume page layout ─────────────────────────────── */

/* Screen layout matches the content pages (80rem, centered) — print
   media below resets this back to the full letter page. */
.resume-shell {
  max-width: 80rem;
  margin: 0 auto 0 auto;
  padding: 0;
}

/* ── Header: portrait + identity block ──────────────── */
/* Avatar mirrors the homepage treatment: circular, top-centered lockup
   with a soft ring + drop shadow. Print media restores the horizontal
   letter-page lockup. */
.resume-header {
  display: grid;
  grid-template-columns: 1fr;
  justify-items: center;
  text-align: center;
  gap: 1rem;
  margin-bottom: 2rem;
  padding-bottom: 1.5rem;
  padding-top: .25rem;
  border-bottom: 2px solid var(--color-sky-reflection-800);
}

.resume-portrait-wrap {
  width: clamp(96px, 9vw, 156px);
  height: clamp(96px, 9vw, 156px);
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  border: 2px solid color-mix(in srgb, var(--anp-base) 78%, var(--surface-color-alt));
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.16);
  background: var(--surface-color);
}

.resume-portrait-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.resume-identity {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.3rem;
}

.resume-name {
  font-size: clamp(1.6rem, 3.4vw, 2.1rem);
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--text-color);
  margin: 0;
  line-height: 1.15;
}

.resume-tagline {
  font-size: 1.125rem;
  color: var(--text-color-muted);
  margin: 0;
  line-height: 1.4;
  max-width: 52ch;
}

.resume-contact {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.5rem 1.25rem;
  margin-top: 0.4rem;
  font-size: 1rem;
  align-items: baseline;
}

.resume-actions {
  display: flex;
  gap: 0.5rem;
}

.resume-contact a {
  color: var(--text-color-link);
  text-decoration: none;
  font-weight: 500;
}

.resume-contact a:hover {
  color: var(--text-color-link-active);
  text-decoration: underline;
}

/* ── Clipboard buttons (in contact bar) ─────────────── */
.btn-clipboard {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.5rem 1rem;
  font-size: 0.875rem;
  font-family: inherit;
  font-weight: 600;
  border: 1px solid var(--btn-edge);
  border-radius: 4px;
  background: var(--btn-surface);
  box-shadow: var(--btn-raise-shadow);
  color: var(--text-color);
  cursor: pointer;
  transition: transform 0.12s ease, box-shadow 0.12s ease, color 0.12s ease;
  text-decoration: none;
}

.btn-clipboard:hover {
  transform: translateY(2px);
  box-shadow: var(--btn-press-shadow);
  color: var(--text-color);
}

.btn-clipboard.copied {
  color: var(--text-color-link);
  transform: translateY(2px);
  box-shadow: var(--btn-press-shadow);
}

/* ── Two-column body ─────────────────────────────────── */
.resume-body {
  display: grid;
  grid-template-columns: 1fr 0.42fr;
  gap: 0 2.5rem;
  align-items: start;
}

.resume-main-col {}
.resume-side-col {}

/* ── Section blocks ─────────────────────────────────── */
.resume-section {
  margin-bottom: 1.75rem;
}

.resume-section-label {
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #fff;
  background: #1a1814;
  padding: 0.2rem 0.6rem;
  display: inline-block;
  margin-bottom: 0.9rem;
  border-radius: 4px;
}

/* ── Experience entries ─────────────────────────────── */
.resume-entry {
  margin-bottom: 1.25rem;
  padding-bottom: 1.1rem;
  border-bottom: 1px solid var(--color-sky-reflection-800);
}

.resume-entry:last-child {
  border-bottom: none;
  margin-bottom: 0;
}

.resume-entry-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 0.5rem;
  flex-wrap: wrap;
  margin-bottom: 0.1rem;
}

.resume-entry-title {
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.01em;
  text-transform: uppercase;
  color: var(--text-color);
  margin: 0;
}

.resume-entry-dates {
  font-size: 0.95rem;
  color: var(--text-color-subtle);
  white-space: nowrap;
  flex-shrink: 0;
}

.resume-entry-org {
  font-size: 1rem;
  font-weight: 600;
  color: var(--text-color);
  margin: 0 0 0.35rem;
}

.resume-entry-body {
  font-size: 1rem;
  color: var(--text-color-muted);
  line-height: 1.6;
  margin: 0;
}

.resume-entry-focus {
  font-size: 0.9rem;
  color: var(--text-color-subtle);
  margin-top: 0.35rem;
}

/* ── Summary ────────────────────────────────────────── */
.resume-summary p {
  font-size: 1.05rem;
  color: var(--text-color-muted);
  line-height: 1.7;
  margin: 0 0 0.65rem;
}

/* ── Skills grid ────────────────────────────────────── */
.resume-skills-group {
  margin-bottom: 0.85rem;
}

.resume-skills-group-name {
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-color-subtle);
  margin: 0 0 0.2rem;
}

.resume-skills-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.3rem;
}

.resume-skill-tag {
  font-size: 0.9rem;
  font-weight: 500;
  background: var(--surface-color);
  color: var(--text-color-muted);
  padding: 0.4rem 0.9rem;
  border-radius: 4px;
  border: 1px solid var(--color-sky-reflection-800);
  display: inline-block;
}

/* ── Education entries ─────────────────────────────── */
.resume-edu-entry {
  margin-bottom: 0.9rem;
  padding-bottom: 0.85rem;
  border-bottom: 1px solid var(--color-sky-reflection-800);
}

.resume-edu-entry:last-child {
  border-bottom: none;
  margin-bottom: 0;
}

.resume-edu-degree {
  font-size: 1rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.01em;
  color: var(--text-color);
  margin: 0;
}

.resume-edu-school {
  font-size: 1rem;
  font-weight: 600;
  color: var(--text-color);
  margin: 0.05rem 0;
}

.resume-edu-year {
  font-size: 0.9rem;
  color: var(--text-color-subtle);
}

/* ── Additional / short entries ────────────────────── */
.resume-short-entry {
  margin-bottom: 0.75rem;
  padding-bottom: 0.7rem;
  border-bottom: 1px solid var(--color-sky-reflection-800);
}

.resume-short-entry:last-child {
  border-bottom: none;
}

/* ─── Mobile: single column ─────────────────────────── */
@media (max-width: 640px) {
  .resume-body {
    grid-template-columns: 1fr;
  }

  .resume-portrait-wrap {
    width: clamp(88px, 24vw, 120px);
    height: clamp(88px, 24vw, 120px);
  }

  .resume-identity {
    width: 100%;
  }

  .resume-contact {
    gap: 0.5rem 0.75rem;
  }

  .resume-actions {
    width: 100%;
    justify-content: center;
  }

  .resume-actions .btn-clipboard {
    flex: 1 1 0;
    justify-content: center;
    min-width: 0;
    padding-inline: 0.6rem;
    font-size: 0.75rem;
    white-space: nowrap;
  }
}

/* ─── Print styles ───────────────────────────────────── */
@media print {
  @page {
    size: letter;
    margin: 0.5in;
  }

  html,
  body {
    background: #fff !important;
    height: auto !important;
    min-height: 0 !important;
  }

  body {
    width: auto !important;
    margin: 0 !important;
    color: var(--text-color) !important;
    font: 9pt/1.45 var(--font-family) !important;
  }

  .site-header,
  .btn-clipboard,
  footer,
  .lightbox-overlay {
    display: none !important;
  }

  .site-wrapper,
  main,
  .page-shell,
  .rich-text,
  .resume-shell {
    background: #fff !important;
  }

  /* Firefox fix: 100vh resolves to screen height in print, causing a blank
     first page. Reset flex layout and all height constraints so the wrapper
     collapses to content height. */
  .site-wrapper {
    display: block !important;
    min-height: 0 !important;
    height: auto !important;
  }

  main {
    margin: 0 !important;
    padding: 0 !important;
    min-height: 0 !important;
    height: auto !important;
  }

  .page-shell,
  .resume-shell {
    max-width: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .resume-shell {
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  .resume-header {
    grid-template-columns: auto 1fr;
    justify-items: start;
    align-items: center;
    text-align: left;
    gap: 0.7rem;
    margin-bottom: 0.55rem;
    padding-bottom: 0.45rem;
    border-bottom: 1.25pt solid var(--color-sky-reflection-800);
    break-inside: avoid;
  }

  .resume-identity {
    align-items: flex-start;
  }

  .resume-contact {
    justify-content: flex-start;
  }

  .resume-portrait-wrap {
    width: 0.72in;
    height: 0.72in;
    border: none;
    box-shadow: none;
  }

  .resume-portrait-wrap img,
  .resume-portrait-wrap picture img {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
  }

  .resume-name {
    font-size: 15pt !important;
  }

  .resume-tagline {
    max-width: none;
    font-size: 7.25pt !important;
    line-height: 1.35;
  }

  .resume-contact {
    gap: 0.15rem 0.55rem;
    margin-top: 0.18rem;
    font-size: 6.75pt !important;
  }

  /* Keep links visibly styled so they read as clickable in the saved PDF */
  .resume-contact a,
  .resume-contact a:visited {
    color: var(--text-color-link) !important;
    text-decoration: underline !important;
  }

  .resume-body {
    gap: 0 0.45in;
    grid-template-columns: minmax(0, 1fr) 2.2in;
  }

  .resume-section {
    margin-bottom: 0.5rem;
  }

  .resume-section-label {
    margin-bottom: 0.35rem;
    padding: 0.12rem 0.4rem;
    font-size: 6pt !important;
    letter-spacing: 0.1em;
    color: #fff !important;
    background: #1a1814 !important;
    border-radius: 4px;
    break-after: avoid;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  .resume-entry,
  .resume-edu-entry,
  .resume-short-entry {
    margin-bottom: 0.4rem;
    padding-bottom: 0.35rem;
    border-bottom-width: 0.5pt;
  }

  .resume-entry,
  .resume-edu-entry,
  .resume-short-entry,
  .resume-skills-group,
  .resume-entry-header,
  .resume-header {
    break-inside: avoid;
  }

  .resume-entry-header {
    margin-bottom: 0.08rem;
  }

  .resume-entry-title,
  .resume-entry-org,
  .resume-edu-degree,
  .resume-edu-school {
    font-size: 7pt !important;
  }

  .resume-entry-dates,
  .resume-entry-focus,
  .resume-edu-year,
  .resume-skills-group-name {
    font-size: 6pt !important;
  }

  .resume-entry-body,
  .resume-summary p {
    font-size: 6.5pt !important;
    line-height: 1.4;
  }

  .resume-summary p {
    margin-bottom: 0.28rem;
  }

  .resume-skills-group {
    margin-bottom: 0.35rem;
  }

  .resume-skills-tags {
    gap: 0.15rem;
  }

  .resume-skill-tag {
    padding: 0.08rem 0.3rem;
    font-size: 5.75pt !important;
    color: var(--text-color-muted) !important;
    background: var(--surface-color) !important;
    border-width: 0.5pt;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
}
{% endcss %}

