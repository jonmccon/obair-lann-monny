  var btn = document.getElementById('resume-copy-btn');
  if (!btn) return;

  btn.addEventListener('click', function() {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(MARKDOWN).then(function() {
        showCopied();
      }).catch(function() {
        fallbackCopy(MARKDOWN);
      });
    } else {
      fallbackCopy(MARKDOWN);
    }
  });

  function showCopied() {
    btn.classList.add('copied');
    btn.textContent = '✓ Copied to clipboard';
    setTimeout(function() {
      btn.classList.remove('copied');
      btn.innerHTML = '<svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="5" y="1" width="9" height="11" rx="1.5" stroke="currentColor" stroke-width="1.5"/><rect x="2" y="4" width="9" height="11" rx="1.5" fill="var(--background-color)" stroke="currentColor" stroke-width="1.5"/></svg> Copy as Markdown';
    }, 2200);
  }

  function fallbackCopy(text) {
    var ta = document.createElement('textarea');
    ta.value = text;
    ta.style.cssText = 'position:fixed;top:-9999px;left:-9999px;opacity:0';
    document.body.appendChild(ta);
    ta.focus();
    ta.select();
    try { document.execCommand('copy'); showCopied(); } catch(e) {}
    document.body.removeChild(ta);
  }
})();
</script>
