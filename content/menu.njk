{%- css %}
/* ─── Menu page layout ─────────────────────────────────── */

.menu-shell {
  max-width: 80rem;
  margin: 0 auto;
  padding: 0;
}

/* ── Page Header ───────────────────────────────────────── */

.menu-header {
  margin-bottom: 2.5rem;
  padding-bottom: 1.5rem;
  padding-top: 0.25rem;
  border-bottom: 2px solid var(--color-sky-reflection-800);
}

.menu-title {
  font-size: clamp(2rem, 4vw, 2.75rem);
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--text-color);
  margin: 0 0 0.75rem;
  line-height: 1.15;
}

.menu-intro {
  font-size: clamp(1rem, 1.8vw, 1.15rem);
  color: var(--text-color);
  line-height: 1.6;
  max-width: 68ch;
  margin: 0;
}

/* ── Section blocks ─────────────────────────────────────── */

.menu-section {
  margin-bottom: 2.75rem;
}

.menu-section-header {
  margin-bottom: 1.25rem;
}

.menu-section-label {
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #fff;
  background: #1a1814;
  padding: 0.2rem 0.6rem;
  display: inline-block;
  margin: 0 0 0.5rem;
  border-radius: 4px;
  line-height: 1.3;
}

.menu-section-note {
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--text-color-muted, var(--text-color));
  margin: 0;
  line-height: 1.4;
}

/* ── Menu entries ───────────────────────────────────────── */

.menu-entry {
  margin-bottom: 1.25rem;
  padding-bottom: 1.1rem;
  border-bottom: 1px solid var(--color-sky-reflection-800);
}

.menu-entry:last-child {
  border-bottom: none;
  margin-bottom: 0;
}

.menu-entry-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 0.5rem;
  flex-wrap: wrap;
  margin-bottom: 0.25rem;
}

.menu-entry-title {
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.01em;
  text-transform: uppercase;
  color: var(--text-color);
  margin: 0;
}

.menu-entry-status {
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--text-color-muted, var(--text-color));
  white-space: nowrap;
  flex-shrink: 0;
}

.menu-entry-body {
  font-size: 0.875rem;
  color: var(--text-color);
  line-height: 1.6;
  margin: 0 0 0.35rem;
  max-width: 72ch;
}

.menu-entry-focus {
  font-size: 0.75rem;
  color: var(--text-color-muted, var(--text-color));
  margin: 0;
  line-height: 1.4;
}

/* ── Full Engagements & CTA ─────────────────────────────── */

.menu-full-body {
  font-size: 0.95rem;
  color: var(--text-color);
  line-height: 1.65;
  margin: 0 0 1.25rem;
  max-width: 72ch;
}

.menu-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  align-items: center;
  margin-top: 1rem;
}

.menu-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  padding: 0.6rem 1.1rem;
  font-size: 0.875rem;
  font-family: inherit;
  font-weight: 600;
  border: 1px solid var(--btn-edge);
  border-radius: var(--btn-radius, 4px);
  background: var(--surface-color);
  color: var(--text-color);
  cursor: pointer;
  transition: transform 0.12s ease, box-shadow 0.12s ease, color 0.12s ease;
  text-decoration: none;
}

.menu-btn:hover {
  transform: translateY(2px);
  box-shadow: var(--btn-press-shadow);
  color: var(--text-color);
}

.menu-btn-primary {
  background: var(--text-color);
  color: var(--background-color);
}

.menu-btn-primary:hover {
  color: var(--background-color);
}

/* ─── Mobile: responsive collapse ───────────────────────── */
@media (max-width: 640px) {
  .menu-header {
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
  }

  .menu-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .menu-btn {
    text-align: center;
  }
}
{% endcss %}

