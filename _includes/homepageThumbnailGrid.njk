{# Homepage project thumbnail grid — square tiles, 24 projects from old jonmccon.com/design #}
{# Data source: _data/projectThumbnails.js #}

<section class="home-project-thumbs" aria-label="Project thumbnails">
  <div class="home-project-thumbs-grid">
    {% for project in projectThumbnails %}
    <a href="{{ project.url }}" class="home-thumb-item" aria-label="{{ project.title }}">
      <img
        src="{{ project.thumbnail }}"
        alt="{{ project.title }}"
        loading="lazy"
        decoding="async"
        width="300"
        height="300"
      >
      <span class="home-thumb-label">{{ project.title }}</span>
    </a>
    {% endfor %}
  </div>
</section>
