{# Archive grid for /archive/ -- same 4-col dense thumbnail layout and markup
   pattern the old projectsThumbGrid.njk used, kept as its own include so
   this file could be edited without touching the (then-live) homepage.
   projectsThumbGrid.njk was later orphaned by the PR2 homepage narrative
   rebuild and removed entirely in PR3 (dead-code cleanup, 2026-11-25) --
   this file is the only surviving renderer of that grid pattern now.

   Adds, per Coordination A.3 of the 2026-11-11 homepage-narrative-redesign
   handoff (data attributes for a later, deferred query-param filtering
   handoff -- not wired to anything yet):
     - data-tags: same lowercased filterTagList-joined shape the old 3D hero used
     - data-project-slug: post.fileSlug, additive only

   Usage: {% set archiveItems = collections.projects | archiveProjects %}
          {% include "archiveThumbGrid.njk" %}
#}
<div class="thumb-grid archive-grid">
  {% for post in archiveItems %}
    {% set tagString = (post.data.tags | filterTagList | join(',')) | lower %}
    {% set thumbnail = post.data.thumbnail %}
    {% if not thumbnail %}
      {% set thumbnail = "" %}
      {% for image in collections.images %}
        {% if image.url == post.url and thumbnail == "" %}
          {% set thumbnail = image.src %}
        {% endif %}
      {% endfor %}
    {% endif %}
    {% if thumbnail %}
      <a href="{{ post.url }}" class="thumb-grid-item" data-tags="{{ tagString }}" data-project-slug="{{ post.fileSlug }}">
        <img src="{{ thumbnail }}" alt="{{ post.data.title }}" loading="lazy" decoding="async"{% if post.data.thumbnail %} width="300" height="300"{% endif %}>
        <span class="thumb-grid-title">{{ post.data.pageHeadline or post.data.title }}</span>
      </a>
    {% endif %}
  {% endfor %}
</div>
