{#-
	Breadcrumb trail + matching BreadcrumbList JSON-LD.

	Renders Home → [top-level section] → [page title] for content that lives
	under a top-level content folder (currently: case studies under /design/,
	process notes under /inProgress/). The visible trail and the JSON-LD are
	built from the exact same computed variables below so they can never drift
	out of sync — if a section has no real URL to link to (e.g. /design/ has
	no archive page), that crumb is rendered as plain text AND the JSON-LD
	"item" property is omitted for it, keeping both representations in sync
	(neither has a URL for that node).

	Usage: {% include "breadcrumbs.njk" %} from within a layout that has
	page.url, title/pageHeadline, and metadata in scope.

	page.url is falsy (false) for draft content excluded from the build
	(see eleventy.config.drafts.js — draft: true resolves permalink to
	false outside serve/watch), so the whole include is guarded below and
	renders nothing for those pages.
#}
{%- if page.url -%}
{%- set _pathParts = page.url.split('/') -%}
{%- set _topSegment = _pathParts[1] if _pathParts.length > 1 else '' -%}

{%- set _sectionName = '' -%}
{%- set _sectionUrl = '' -%}
{%- if _topSegment == 'design' -%}
	{%- set _sectionName = 'Design' -%}
{%- elif _topSegment == 'inProgress' -%}
	{%- set _sectionName = 'Process' -%}
	{%- set _sectionUrl = '/process/' | htmlBaseUrl(metadata.url) -%}
{%- endif -%}

{%- set _pageTitle = pageHeadline or title -%}

{%- if _pageTitle -%}
{%- set _homeUrl = '/' | htmlBaseUrl(metadata.url) -%}
{%- set _pageUrl = page.url | htmlBaseUrl(metadata.url) -%}

{%- css %}
.breadcrumbs { margin: 0 0 0.75rem; }
.breadcrumb-list { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35em; list-style: none; margin: 0; padding: 0; font-size: 0.875rem; }
.breadcrumb-item { display: flex; align-items: center; gap: 0.35em; }
.breadcrumb-item a { text-decoration: none; }
.breadcrumb-item a:hover { text-decoration: underline; }
.breadcrumb-separator { opacity: 0.5; }
{% endcss %}

<nav class="breadcrumbs" aria-label="Breadcrumb">
	<ol class="breadcrumb-list">
		<li class="breadcrumb-item">
			<a href="{{ _homeUrl }}">Home</a>
			<span class="breadcrumb-separator" aria-hidden="true">›</span>
		</li>
		{%- if _sectionName %}
		<li class="breadcrumb-item">
			{%- if _sectionUrl %}
			<a href="{{ _sectionUrl }}">{{ _sectionName }}</a>
			{%- else %}
			<span>{{ _sectionName }}</span>
			{%- endif %}
			<span class="breadcrumb-separator" aria-hidden="true">›</span>
		</li>
		{%- endif %}
		<li class="breadcrumb-item">
			<span aria-current="page">{{ _pageTitle }}</span>
		</li>
	</ol>
</nav>

<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{
			"@type": "ListItem",
			"position": 1,
			"name": "Home",
			"item": {{ _homeUrl | dump | safe }}
		}{% if _sectionName %},
		{
			"@type": "ListItem",
			"position": 2,
			"name": {{ _sectionName | dump | safe }}{% if _sectionUrl %},
			"item": {{ _sectionUrl | dump | safe }}{% endif %}
		}{% endif %},
		{
			"@type": "ListItem",
			"position": {{ 3 if _sectionName else 2 }},
			"name": {{ _pageTitle | dump | safe }},
			"item": {{ _pageUrl | dump | safe }}
		}
	]
}
</script>
{%- endif -%}
{%- endif -%}
