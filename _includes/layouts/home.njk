---
layout: layouts/base.njk
---
{%- css %}
/* Homepage narrative rebuild (PR2, 2026-11-17).
   Accent: reuses the existing --color-peach-glow-* tokens (same family
   PR1's /archive/ already scoped as --archive-accent) rather than a new
   terracotta token -- it visually matches terracotta/clay closely enough,
   and is already the --text-color-muted accent on html.theme-home (see
   public/css/index.css ~L97). Two variants, matching PR1's light/dark
   split:
     --home-accent-void  (peach-glow-400, 7.6:1 on black-900) for TEXT
       inside the dark "dossier card" artifact panels (void background).
     --home-accent-edge  (peach-glow-800, 4.3:1 contrast, >=3:1 non-text
       UI-component threshold) for borders/rules on the page's own
       green (jungle-500) field -- the home theme's field color is a
       saturated green, not a light neutral, so peach-glow TEXT directly
       on it fails normal-text AA; non-text accents (borders) only need
       3:1 (WCAG 1.4.11) and pass comfortably. All body text on the green
       field uses the existing --text-color (black-900, 7.0:1, unchanged).
   Monospace: existing --font-family-mono (Space Mono, already
   self-hosted + preloaded in base.njk). Narrative body: existing
   --font-family (Outfit) -- the site already uses one sans family for
   both headline and body, which already satisfies "distinct mono vs.
   narrative" without introducing a new font. No new fonts added. */
.home-hero,
.home-case-studies,
.home-transition {
	--home-accent-void: var(--color-peach-glow-400);
	--home-accent-edge: var(--color-peach-glow-800);
	--home-void-bg: var(--color-black-900);
	--home-void-text: var(--color-black-50);
	/* .home-supporting-content (the parent grid) sets text-align:center +
	   justify-items:center for the testimonial/podcast/aside stack -- the
	   narrative hero/case-study/transition copy reads as left-aligned
	   editorial body text instead (matches the Pinterest direction's
	   two-column editorial-grid reference, pin #5), so it's overridden
	   back here rather than changing the shared parent rule. */
	text-align: left;
	justify-self: stretch;
	width: 100%;
}

.home-hero {
	max-width: min(64rem, 92vw);
	margin: 0 auto;
	padding: clamp(2rem, 6vw, 4.5rem) 0 clamp(1.5rem, 4vw, 2.5rem);
}

.home-hero-headline {
	margin: 0 0 1.25rem;
	max-width: 22ch;
}

.home-hero-headline .home-hero-line {
	display: block;
}

.home-hero-bio {
	max-width: 62ch;
	font-size: 1.05rem;
	line-height: 1.6;
}

.home-hero-bio p {
	margin: 0 0 1em;
}

.home-case-studies {
	display: flex;
	flex-direction: column;
	gap: clamp(2.5rem, 6vw, 4.5rem);
	margin: clamp(2rem, 5vw, 3.5rem) 0;
}

.home-case-study {
	background: var(--home-void-bg);
	color: var(--home-void-text);
	border-radius: 0.75rem;
	padding: clamp(1.25rem, 4vw, 2.5rem);
	border-top: 3px solid var(--home-accent-edge);
}

.home-case-study-seq {
	font-family: var(--font-family-mono);
	font-size: 0.8rem;
	letter-spacing: 0.08em;
	color: var(--home-accent-void);
	margin-bottom: 0.75rem;
}

.home-case-study-title {
	color: var(--home-void-text);
	margin: 0 0 0.5rem;
}

.home-case-study-hero-sentence {
	font-size: 1.15rem;
	line-height: 1.45;
	max-width: 56ch;
	margin: 0 0 1.5rem;
}

.home-case-study-dossier {
	font-family: var(--font-family-mono);
	font-size: 0.8rem;
	line-height: 1.5;
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
	gap: 0.5rem 1.5rem;
	margin: 0 0 1.5rem;
	padding: 1rem 1.25rem;
	border: 1px solid color-mix(in srgb, var(--home-void-text) 20%, transparent);
	border-radius: 0.5rem;
}

.home-case-study-dossier-row {
	display: flex;
	gap: 0.5rem;
}

.home-case-study-dossier-row dt {
	flex: 0 0 5.5rem;
	color: var(--home-accent-void);
	text-transform: uppercase;
	letter-spacing: 0.04em;
}

.home-case-study-dossier-row dd {
	margin: 0;
	color: var(--home-void-text);
}

.home-case-study-body {
	max-width: 68ch;
	line-height: 1.65;
	margin: 0 0 1.75rem;
}

.home-case-study-media {
	display: grid;
	grid-template-columns: 1.4fr 1fr;
	gap: 1.25rem;
	margin: 0 0 1.5rem;
}

@media (max-width: 42rem) {
	.home-case-study-media {
		grid-template-columns: 1fr;
	}
}

.home-case-study-artifact {
	margin: 0;
}

.home-case-study-artifact-img {
	display: block;
	width: 100%;
	height: auto;
	border-radius: 0.375rem;
}

.home-case-study-artifact figcaption {
	margin-top: 0.4rem;
	font-size: 0.72rem;
	font-family: var(--font-family-mono);
	color: var(--home-accent-void);
}

.home-case-study-artifact-placeholder {
	aspect-ratio: 4 / 3;
	display: flex;
	align-items: center;
	justify-content: center;
	text-align: center;
	padding: 1rem;
	font-family: var(--font-family-mono);
	font-size: 0.75rem;
	color: var(--home-void-text);
	border: 1px dashed color-mix(in srgb, var(--home-void-text) 35%, transparent);
	border-radius: 0.375rem;
}

.home-case-study-link {
	display: inline-block;
	font-weight: var(--font-weight-semibold);
	color: var(--home-void-text);
	text-underline-offset: 0.2em;
}

.home-case-study-link:hover,
.home-case-study-link:focus-visible {
	color: var(--home-accent-void);
}

.home-transition {
	max-width: min(64rem, 92vw);
	margin: clamp(2rem, 5vw, 3.5rem) auto;
	padding-top: clamp(1.5rem, 4vw, 2.5rem);
	border-top: 1px solid color-mix(in srgb, var(--text-color) 15%, transparent);
}

.home-transition-line {
	max-width: 62ch;
	line-height: 1.6;
	margin: 0 0 1rem;
}

.home-transition-link {
	display: inline-block;
	font-weight: var(--font-weight-bold);
	border-bottom: 2px solid var(--home-accent-edge);
}

@media (prefers-reduced-motion: reduce) {
	.home-case-study-link,
	.home-transition-link {
		transition: none;
	}
}
{% endcss %}
{% if page.url == "/" %}
{% include "schema-person.njk" %}

{#- Homepage narrative rebuild (PR2, 2026-11-17). Replaces the Three.js
    homepage-axis-hero (radial career-clock chart) with a single hero
    (ONE <h1> on the page) + bio, followed by the 7 narrative case-study
    blocks driven by collections.homeFeaturedProjects (sorted by
    featuredOrder in eleventy.config.js -- not re-sorted here) and
    _data/homeBlocks.json for the locked, verbatim copy-doc text per
    project. Testimonials + podcast keep their existing markup, moved
    below block 7 and above the Archive transition/link per the
    2026-11-11 handoff's default decision. Three.js script blocks, the
    featuredProjects/semiFeaturedProjects-driven projectsThumbGrid
    include, and the old introductionHeading/introductionText "about"
    paragraph (superseded by the new locked bio copy -- rendering both
    would duplicate the same bio facts in two different wordings) are
    removed from "/" only; nothing is deleted from the repo (PR3 scope). #}

<section class="home-hero" aria-label="Homepage hero">
  <h1 class="home-hero-headline">
    <span class="home-hero-line">Designer for places with no infrastructure and real stakes.</span>
    <span class="home-hero-line">I build what&rsquo;s missing &mdash; then leave something others can run without me.</span>
  </h1>
  <div class="home-hero-bio">
    <p>Jonny is a product designer and creative technologist with one foot in design, one in photography, one in building the internet, and one in the classroom. Over 15 years he&rsquo;s shipped operating system experiences to 40M+ users at Amazon, real-time communication tools at Google, and healthcare platforms for clinical teams at Providence. Work that lives at the intersection of complex systems and the humans who depend on them.</p>
    <p>He&rsquo;s a tinkerer, a sailor, a chef, and generally just wants to learn how things are made.</p>
  </div>
</section>

<section class="home-supporting-content" aria-label="Homepage supporting content">

  <section class="home-case-studies" aria-label="Featured case studies">
    {%- set totalBlocks = collections.homeFeaturedProjects.length %}
    {%- for post in collections.homeFeaturedProjects %}
    {%- set block = homeBlocks[post.fileSlug] %}
    <article class="home-case-study"
      data-project-slug="{{ post.fileSlug }}"
      data-project-tags="{{ (post.data.tags | filterTagList | join(',')) | lower }}"
      aria-labelledby="case-study-{{ post.fileSlug }}-title">

      <div class="home-case-study-seq" aria-hidden="true">{{ loop.index | zeroPad }} / {{ totalBlocks | zeroPad }}</div>

      <h2 class="home-case-study-title" id="case-study-{{ post.fileSlug }}-title">{{ block.title }}</h2>
      <p class="home-case-study-hero-sentence">{{ block.heroSentence }}</p>

      <dl class="home-case-study-dossier">
        <div class="home-case-study-dossier-row"><dt>Role</dt><dd>{{ block.dossier.role }}</dd></div>
        <div class="home-case-study-dossier-row"><dt>Company</dt><dd>{{ block.dossier.company }}</dd></div>
        <div class="home-case-study-dossier-row"><dt>Timeline</dt><dd>{{ block.dossier.timeline }}</dd></div>
        <div class="home-case-study-dossier-row"><dt>Team</dt><dd>{{ block.dossier.team }}</dd></div>
        <div class="home-case-study-dossier-row"><dt>Stakes</dt><dd>{{ block.dossier.stakes }}</dd></div>
        <div class="home-case-study-dossier-row"><dt>Status</dt><dd>{{ block.dossier.status }}</dd></div>
      </dl>

      <p class="home-case-study-body">{{ block.body }}</p>

      <div class="home-case-study-media">
        <figure class="home-case-study-artifact home-case-study-artifact-hero">
          {% homepageImage block.heroArtifact.src, block.heroArtifact.alt, block.heroArtifact.width, "home-case-study-artifact-img" %}
          <figcaption>{{ block.heroArtifact.alt }}</figcaption>
        </figure>
        <figure class="home-case-study-artifact home-case-study-artifact-process">
          {% if block.processArtifact %}
          {% homepageImage block.processArtifact.src, block.processArtifact.alt, block.processArtifact.width, "home-case-study-artifact-img" %}
          <figcaption>{{ block.processArtifact.alt }}</figcaption>
          {% else %}
          <div class="home-case-study-artifact-placeholder" role="img" aria-label="Process artifact not yet selected for this project">Process artifact pending &mdash; see PR notes</div>
          <figcaption>Placeholder &mdash; no suitable existing process image found in content/design/{{ post.fileSlug }}/</figcaption>
          {% endif %}
        </figure>
      </div>

      <a class="home-case-study-link" href="{{ post.url }}">View case study &rarr;</a>
    </article>
    {%- endfor %}
  </section>

  <section class="home-testimonial-strip" aria-label="Recommendations">
    <div class="home-testimonial-grid">
      <blockquote class="home-testimonial">
        <p class="home-testimonial-quote">"Jonny's end-to-end design process is impressive, as he is able to take an idea from conception to delivery while ensuring that the end product meets the needs of the users."</p>
        <footer class="home-testimonial-footer">
          <span class="home-testimonial-avatar" aria-hidden="true"><img src="/img/testimonials/jeremy-w.png" alt="Jeremy Wheat" width="40" height="40"></span>
          <cite class="home-testimonial-attribution">
            <a href="https://www.linkedin.com/in/jeremywheat/" target="_blank" rel="noreferrer">Jeremy Wheat</a>
            <span class="home-testimonial-role">Senior Manager, Cloud Engineering, Data &amp; Analytics</span>
          </cite>
        </footer>
      </blockquote>

      <blockquote class="home-testimonial">
        <p class="home-testimonial-quote">"He challenged the status quo with his design process and methodology and consistently designed meaningful experiences for our users."</p>
        <footer class="home-testimonial-footer">
          <span class="home-testimonial-avatar" aria-hidden="true">
            <img src="/img/testimonials/mike-vw.png" alt="Mike Van Wagoner" width="40" height="40">
          </span>
          <cite class="home-testimonial-attribution">
            <a href="https://www.linkedin.com/in/mike-van-wagoner/" target="_blank" rel="noreferrer">Mike Van Wagoner</a>
            <span class="home-testimonial-role">Product Design Leader</span>
          </cite>
        </footer>
      </blockquote>
    </div>
  </section>

  <section class="home-podcast-feature" aria-label="Podcast">
    <div class="home-podcast-grid">
      <div class="home-podcast-copy">
        <h2 class="home-podcast-title">Seattle Creative Show</h2>
        <p class="home-podcast-desc">Conversations with Seattle's working creative community of designers, founders, makers, and the people who make the Pacific Northwest.</p>
      </div>
      <div class="home-podcast-players">
        <iframe class="home-supporting-player" height="200" width="100%" frameborder="no" scrolling="no" seamless src="https://player.simplecast.com/9fc38fe1-df84-4a61-8348-b4a888606182?dark=false" title="SCD Podcast episode 1"></iframe>
        <iframe class="home-supporting-player" height="200" width="100%" frameborder="no" scrolling="no" seamless src="https://player.simplecast.com/a8c63034-9b6c-4d56-b3ed-e440f6a3e031?dark=false" title="SCD Podcast episode 2"></iframe>
      </div>
    </div>
          <a href="https://seattlecreative.simplecast.com/" target="_blank" rel="noreferrer">
        <div class="home-supporting-link home-podcast-all-link">
          Hear all episodes ↗
        </div>
      </a>
  </section>  

  <section class="home-transition" aria-label="Transition to Archive">
    <p class="home-transition-line">That's the pattern across the last ten years: no infrastructure, real stakes, build what's missing. Earlier work &mdash; branding, events, print, interactive &mdash; lives in the archive.</p>
    <a class="home-transition-link" href="/archive/">Everything else &rarr;</a>
  </section>

  <aside class="home-aside-row">
    <a class="home-aside-link" href="https://community.obsidian.md/plugins/time-blocks" target="_blank" rel="noreferrer">
      <img class="home-aside-thumb" src="/img/thumbnails/resize-block.gif" alt="Obsidian Time Blocks — resizing a time block" width="180" loading="lazy">
      <div class="home-aside-copy">
        <div class="home-aside-header">
          <span class="home-aside-label">Check it out</span>
          <span class="home-aside-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
              <circle cx="12" cy="12" r="8.25" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 7.9v4.85l3.15 1.95" />
            </svg>
          </span>
        </div>
        <span class="home-aside-text">Obsidian Time Blocks - a lightweight time-blocking plugin for focused work.</span>
      </div>
    </a>
  </aside>

</section>

{% endif %}

{{ content | safe }}
