</section>

<script>
// Headline fallback controller. The DOM <h1> is hidden up-front via the `.js`
// class (see base.njk + index.css). If the Three.js module fails to load or
// throws before it can paint the WebGL headline, reveal the DOM <h1> so the
// heading is never lost. The module sets `window.__axisReady` + clears the timer
// once it has successfully painted.
(function () {
  function revealHeadline() {
    if (window.__axisReady) return;
    var overlay = document.querySelector('[data-chart-headline]');
    if (overlay) overlay.classList.add('is-fallback');
  }
  window.__axisRevealHeadline = revealHeadline;
  // Load/execute failure safety net — shrinks with the modulepreload in <head>.
  window.__axisFallbackTimer = window.setTimeout(revealHeadline, 3500);
  // Immediate reveal on an evaluation error (e.g. WebGL unsupported).
  window.addEventListener('error', revealHeadline);
})();
</script>

<script type="importmap">
{
  "imports": {
    "three": "https://esm.sh/three@0.169.0"
  }
}
</script>

<script type="module">
import {
  Scene, PerspectiveCamera, WebGLRenderer,
  TubeGeometry, CatmullRomCurve3, CircleGeometry, SphereGeometry,
  MeshStandardMaterial, MeshBasicMaterial, ShaderMaterial,
  Mesh, PlaneGeometry, DoubleSide, FrontSide, NormalBlending,
  LineSegments, BufferGeometry, Float32BufferAttribute,
  LineBasicMaterial,
  AmbientLight, DirectionalLight, PointLight,
  TextureLoader, CanvasTexture,
  Color, Raycaster, Vector2, Vector3, Quaternion,
  Group, SRGBColorSpace
} from 'three';

// ── Guard ────────────────────────────────────────────────────────────────────
const stage      = document.querySelector('[data-axis-stage]');
const canvas     = document.querySelector('[data-axis-canvas]');
const projectEls = Array.from(document.querySelectorAll('[data-axis-project]'));
const headlineEl = document.querySelector('[data-chart-headline]');
const headlineH1 = headlineEl ? headlineEl.querySelector('h1') : null;
const bgStrip    = document.querySelector('[data-chart-bg]');
if (!stage || !canvas || !projectEls.length) throw new Error('[axis] missing DOM');

// ── Default headline text ────────────────────────────────────────────────────
const DEFAULT_HEADLINE = headlineH1 ? headlineH1.textContent : '';

// ── Renderer ─────────────────────────────────────────────────────────────────
const renderer = new WebGLRenderer({ canvas, antialias: true, alpha: true });
renderer.setClearColor(0x000000, 0);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
const maxAniso = renderer.capabilities.getMaxAnisotropy();

function syncSize() {
  const w = stage.clientWidth;
  const h = stage.clientHeight;
  renderer.setSize(w, h, false);
  const aspect = w / h;
  camera.aspect = aspect;

  // Dolly the camera along its fixed view direction so the chart's content
  // radius always stays inside BOTH the horizontal and vertical field of view.
  // A fixed camera distance clipped the outer tubes + headline at narrow /
  // in-between viewport aspects; we never move closer than the tuned default
  // distance, so wide desktops keep their original framing.
  const tanHalfV = Math.tan((camera.fov * Math.PI / 180) / 2);
  const distForWidth  = FIT_RADIUS_X / (tanHalfV * aspect);
  const distForHeight = FIT_RADIUS_Y / tanHalfV;
  let dist;
  if (w <= 768) {
    // Mobile: intentionally let the tubes overflow the viewport for bolder,
    // mobile-oriented proportions. Rather than framing the whole chart radius,
    // we only guarantee the (enlarged) headline billboard stays fully visible;
    // the outer tubes spill off the edges.
    const marginedHalfW = (HEADLINE_PLANE_W / 2) * 1.08;
    const marginedHalfH = (HEADLINE_PLANE_H / 2) * 1.08;
    const distHeadlineW = marginedHalfW / (tanHalfV * aspect);
    const distHeadlineH = marginedHalfH / tanHalfV;
    dist = Math.max(distHeadlineW, distHeadlineH);
  } else {
    dist = Math.max(DEFAULT_CAMERA_DISTANCE, distForWidth, distForHeight);
  }
  camera.position.copy(CAMERA_DIR).multiplyScalar(dist);
  camera.lookAt(0, 0, 0);

  camera.updateProjectionMatrix();
  logCameraPosition('resize');
}

// ── Scene + Camera ───────────────────────────────────────────────────────────
const scene  = new Scene();
const camera = new PerspectiveCamera(58, 1, 0.1, 2000);
// Overhead-left view — camera high + left, looking down-right at chart center
// Matches reference: steep overhead, clock face nearly horizontal, shifted left
// DEFAULT_CAMERA_POSITION — edit this to change the chart's starting viewpoint.
// Logged to console on every camera update below so new defaults can be read off directly.
const DEFAULT_CAMERA_POSITION = { x: -120, y: 320, z: 340 };
camera.position.set(DEFAULT_CAMERA_POSITION.x, DEFAULT_CAMERA_POSITION.y, DEFAULT_CAMERA_POSITION.z);
camera.lookAt(0, 0, 0);

// ── Responsive framing ────────────────────────────────────────────────────────
// The camera only ever dollies in/out along this fixed direction; syncSize()
// recomputes the distance per-resize so tubes + headline never clip.
const CAMERA_DIR = new Vector3(
  DEFAULT_CAMERA_POSITION.x, DEFAULT_CAMERA_POSITION.y, DEFAULT_CAMERA_POSITION.z
).normalize();
const DEFAULT_CAMERA_DISTANCE = Math.hypot(
  DEFAULT_CAMERA_POSITION.x, DEFAULT_CAMERA_POSITION.y, DEFAULT_CAMERA_POSITION.z
);
// World-space half-extents that must stay in frame: outer team ring (280) +
// tube radius (20) + margin horizontally; elevation range (200) + margin vertically.
const FIT_RADIUS_X = 340;
const FIT_RADIUS_Y = 240;

// Print camera position to console whenever it changes (drag rotation, resize, etc.)
// so the current view can be captured and pasted back in as the new default.
// Drag rotation actually spins `meshGroup` (rotX/rotY below), not the camera itself —
// so on every user-driven change we log both the (static) camera xyz AND the live
// rotX/rotY, since those together are what you dial in to define the "default" view.
function logCameraPosition(reason) {
  const { x, y, z } = camera.position;
  // rotX/rotY are declared later (drag rotation state) — guard with a try/catch
  // rather than `typeof`, since `typeof` on a not-yet-initialized `let` throws
  // (temporal dead zone) instead of returning 'undefined'.
  let rotation;
  try {
    rotation = { rotX: +rotX.toFixed(1), rotY: +rotY.toFixed(1) };
  } catch (e) {
    rotation = undefined;
  }
  console.log(
    `[axis-chart] camera.position (${reason}):`,
    { x: +x.toFixed(1), y: +y.toFixed(1), z: +z.toFixed(1) },
    rotation
  );
}
logCameraPosition('init');

// ── Lights ───────────────────────────────────────────────────────────────────
scene.add(new AmbientLight(0xffffff, 0.85));
const sun = new DirectionalLight(0xd0eeff, 0.9);
sun.position.set(1.2, 2, 1.5);
scene.add(sun);
const fill = new PointLight(0x7287fd, 0.6, 1800);
fill.position.set(-220, 140, 340);
scene.add(fill);

// ── Headline billboard — real mesh in the 3D scene, SAME billboard plane as avatar ──
// Previously a CSS overlay pinned at z-index:0 (always BEHIND the canvas, tubes could
// only ever pass in front of it, never behind). Moving it into the scene next to the
// avatar mesh — same technique, same depth defaults — lets the WebGL depth buffer sort
// tube arcs in front of AND behind the headline text, exactly like the avatar.
const HEADLINE_CANVAS_W = 1600;
const HEADLINE_CANVAS_H = 620;
const headlineCanvas = document.createElement('canvas');
headlineCanvas.width  = HEADLINE_CANVAS_W;
headlineCanvas.height = HEADLINE_CANVAS_H;
const hctx = headlineCanvas.getContext('2d');

// Colors/weights mirror the reference headline CSS on main (.homepage-headline-axis):
// font-weight 800 variable, letter-spacing -0.02em, uppercase, color-mix(text-color 88%, anp-base)
function wrapHeadline(words, maxWidth) {
  const lines = [];
  let line = '';
  words.forEach(word => {
    const test = line ? `${line} ${word}` : word;
    if (line && hctx.measureText(test).width > maxWidth) {
      lines.push(line);
      line = word;
    } else {
      line = test;
    }
  });
  if (line) lines.push(line);
  return lines;
}

function drawHeadlineText(text, dimmed) {
  hctx.clearRect(0, 0, HEADLINE_CANVAS_W, HEADLINE_CANVAS_H);
  hctx.textAlign = 'center';
  hctx.textBaseline = 'middle';
  hctx.fillStyle = '#28251f';

  const words    = (text || '').toUpperCase().split(' ');
  const maxWidth = HEADLINE_CANVAS_W - 48;

  // Fixed size for every headline + rollover title (consistent, not fill-to-fit).
  const fontSize   = 96;
  const lineHeight = fontSize * 0.98;
  hctx.font = `800 ${fontSize}px 'Google Sans Flex', 'Outfit', system-ui, sans-serif`;
  const lines = wrapHeadline(words, maxWidth);

  const totalH = lines.length * lineHeight;
  let y = (HEADLINE_CANVAS_H - totalH) / 2 + lineHeight / 2;
  lines.forEach(l => { hctx.fillText(l, HEADLINE_CANVAS_W / 2, y); y += lineHeight; });

  if (headlineTex) headlineTex.needsUpdate = true;
}

let headlineTex   = null;
let headlinePlane = null;
// Headline plane world size. On mobile the headline is rendered noticeably
// LARGER for mobile-oriented proportions — the tubes are allowed to overflow the
// viewport there (see syncSize), so the headline needs more presence. On desktop
// it stays sized to sit centered within the fully-framed chart.
const HEADLINE_IS_MOBILE = window.matchMedia('(max-width: 768px)').matches;
const HEADLINE_PLANE_W = HEADLINE_IS_MOBILE ? 470 : 580;
const HEADLINE_PLANE_H = HEADLINE_PLANE_W * (HEADLINE_CANVAS_H / HEADLINE_CANVAS_W);
if (headlineH1) {
  headlineTex = new CanvasTexture(headlineCanvas);
  headlineTex.colorSpace = SRGBColorSpace;
  drawHeadlineText(DEFAULT_HEADLINE, false);
  headlinePlane = new Mesh(
    new PlaneGeometry(HEADLINE_PLANE_W, HEADLINE_PLANE_H),
    new MeshBasicMaterial({ map: headlineTex, transparent: true, side: DoubleSide })
    // depthWrite/depthTest left at their defaults (true) so tube geometry sorts
    // naturally in front of and behind this plane.
  );
  headlinePlane.position.set(0, 0, 0);
  scene.add(headlinePlane);
  // The DOM/CSS <h1> stays hidden via the `.js` class (base.njk) — it's now only
  // a text data source for drawHeadlineText and a no-JS fallback.
}

// ── Avatar billboard — real mesh in the 3D scene ─────────────────────────────
// Previously a CSS overlay pinned above everything (avatar > tubes > headline
// always). Moving it into the scene at the origin lets the WebGL depth buffer
// sort it against tube geometry naturally: tubes nearer the camera than the
// avatar plane occlude it, tubes farther away are occluded by it — a real
// middle plane, not a fixed z-index split.
// Avatar is now a DOM element pinned over the top of the stage (see markup +
// .home-axis-avatar CSS), not a mesh in the scene.

// ── Radial chart constants ────────────────────────────────────────────────────
const CAREER_START_YEAR  = 2010;
const CAREER_START_MONTH = 1;
const CAREER_END_YEAR    = 2026;
const CAREER_END_MONTH   = 8;
const CAREER_MONTHS      = (CAREER_END_YEAR - CAREER_START_YEAR) * 12
                           + (CAREER_END_MONTH - CAREER_START_MONTH); // 199

const RADIANS_PER_MONTH = (2 * Math.PI) / CAREER_MONTHS;
const THETA_6OCLOCK     = -Math.PI / 2;   // bottom of clock (−Y axis)

const R_INNER  = 100;   // solo projects radius
const R_OUTER  = 280;   // team projects radius
const Y_RANGE  = 200;   // ± elevation (medium axis depth)
const TUBE_R   = 20;    // tube cross-section radius
const ARC_SEGS = 72;    // arc curve resolution

// ── Tube color ramp — solid greens pulled from the jungle palette ─────────────
// Each project gets a distinct, stable green spread across the light↔dark jungle
// range (new-colors.css: medium-jungle-300 #91d4a3 → medium-jungle-800 #1d4929),
// so tubes read as solid jungle tones rather than per-image dominant colors.
const JUNGLE_LIGHT = new Color(0x91d4a3);
const JUNGLE_DARK  = new Color(0x1d4929);
function slugHash(s) {
  let h = 0;
  for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0;
  return h;
}
function jungleTubeColor(slug) {
  const t = slug ? (slugHash(slug) % 1000) / 999 : 0.5;
  return JUNGLE_LIGHT.clone().lerp(JUNGLE_DARK, t);
}

// ── Dots texture — rough field of tiny dots, no gloss ────────────────────────
function makeDotsTexture(size = 256) {
  const c = document.createElement('canvas');
  c.width = c.height = size;
  const ctx = c.getContext('2d');
  ctx.fillStyle = '#c8cdd8';
  ctx.fillRect(0, 0, size, size);
  const dotRadius = 1.1;
  const spacing   = 7;
  ctx.fillStyle = 'rgba(80,88,108,0.55)';
  for (let y = spacing / 2; y < size; y += spacing) {
    for (let x = spacing / 2; x < size; x += spacing) {
      ctx.beginPath();
      ctx.arc(x + (Math.random() - 0.5) * 1.5, y + (Math.random() - 0.5) * 1.5, dotRadius, 0, Math.PI * 2);
      ctx.fill();
    }
  }
  return new CanvasTexture(c);
}

const dotsTex = makeDotsTexture(256);

// ── Helper: months since career start ────────────────────────────────────────
function monthsElapsed(dateStr) {
  if (!dateStr) return 0;
  const [y, m] = dateStr.split('-').map(Number);
  return Math.max(0, (y - CAREER_START_YEAR) * 12 + (m - CAREER_START_MONTH));
}

// ── Helper: point on circle at radius r, elevation y, angle theta ─────────
function circlePoint(r, yElev, theta) {
  return new Vector3(r * Math.cos(theta), yElev, r * Math.sin(theta));
}

// ── Helper: build arc curve ───────────────────────────────────────────────
function makeArcCurve(r, yElev, thetaStart, thetaEnd) {
  const pts = [];
  for (let i = 0; i <= ARC_SEGS; i++) {
    const t   = i / ARC_SEGS;
    const ang = thetaStart + t * (thetaEnd - thetaStart);
    pts.push(circlePoint(r, yElev, ang));
  }
  return new CatmullRomCurve3(pts, false, 'catmullrom', 0.0);
}

// ── Axis reference rings ──────────────────────────────────────────────────────
function makeRingVerts(r, segments = 128) {
  const verts = [];
  for (let i = 0; i <= segments; i++) {
    const a  = (i / segments) * 2 * Math.PI;
    const a2 = ((i + 1) / segments) * 2 * Math.PI;
    verts.push(r * Math.cos(a), 0, r * Math.sin(a));
    verts.push(r * Math.cos(a2), 0, r * Math.sin(a2));
  }
  return new Float32Array(verts);
}

const ringMat = new LineBasicMaterial({ color: 0x7287fd, transparent: true, opacity: 0.12 });
for (const r of [R_INNER, (R_INNER + R_OUTER) / 2, R_OUTER]) {
  const rg = new BufferGeometry();
  rg.setAttribute('position', new Float32BufferAttribute(makeRingVerts(r), 3));
  scene.add(new LineSegments(rg, ringMat.clone()));
}

// Career-start tick line
const tickVerts = new Float32Array([0, 0, -R_OUTER * 1.05, 0, 0,  R_OUTER * 1.05]);
const tickGeo   = new BufferGeometry();
tickGeo.setAttribute('position', new Float32BufferAttribute(tickVerts, 3));
scene.add(new LineSegments(tickGeo, new LineBasicMaterial({ color: 0x9ca0b0, transparent: true, opacity: 0.15 })));


// ── Ephemeral tube shader ─────────────────────────────────────────────────────
// A soft, translucent, fresnel-lit look instead of a solid MeshStandard surface.
// Near the world z=0 plane (where the headline + avatar billboards sit) the
// geometry scatters outward and its surface breaks into sparse glowing speckles —
// so each arc appears to disperse into a cloud of particles, pass through the
// headline, and reassemble on the far side of the plane.
const DISPERSE_BAND = 46;   // half-thickness (world units) of the dispersion zone
const DISPERSE_SCATTER = 18; // max outward scatter distance at the plane
// The dispersion plane matches the headline billboard: it passes through the
// origin with a normal pointing at the (static) camera, so tubes break up flat
// against the text plane rather than through an off-axis world plane.
const PLANE_NORMAL = camera.position.clone().normalize();

const TUBE_VERT = /* glsl */`
  uniform float uTime;
  uniform float uBandHalf;
  uniform float uScatter;
  uniform vec3  uPlaneN;
  varying vec3 vWorldPos;
  varying vec3 vNormalW;
  varying vec2 vUv;
  varying float vDisperse;

  float hash13(vec3 p){
    p = fract(p * 0.3183099 + 0.1);
    p *= 17.0;
    return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
  }

  void main(){
    vUv = uv;
    vec4 wp = modelMatrix * vec4(position, 1.0);
    // Signed distance to the headline's (camera-facing) plane through the origin →
    // 1 on the plane, 0 at the band edge, so the effect sits flat against the text.
    float d = 1.0 - clamp(abs(dot(wp.xyz, uPlaneN)) / uBandHalf, 0.0, 1.0);
    float disp = smoothstep(0.0, 1.0, d);
    vDisperse = disp;

    // Per-vertex scatter direction (stable hash) + gentle time shimmer.
    vec3 dir = normalize(vec3(
      hash13(position * 1.7),
      hash13(position * 3.1 + 5.0),
      hash13(position * 2.3 + 9.0)
    ) * 2.0 - 1.0);
    float shimmer = sin(uTime * 2.2 + hash13(position) * 6.2831) * 0.5 + 0.5;
    vec3 scattered = position + dir * disp * uScatter * (0.55 + 0.45 * shimmer);

    vec4 wp2 = modelMatrix * vec4(scattered, 1.0);
    vWorldPos = wp2.xyz;
    vNormalW = normalize(mat3(modelMatrix) * normal);
    gl_Position = projectionMatrix * viewMatrix * wp2;
  }
`;

const TUBE_FRAG = /* glsl */`
  uniform vec3  uColor;
  uniform float uOpacity;
  uniform float uHover;
  uniform float uTime;
  uniform sampler2D uMap;
  uniform float uHasMap;
  varying vec3 vWorldPos;
  varying vec3 vNormalW;
  varying vec2 vUv;
  varying float vDisperse;

  float hash21(vec2 p){
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
  }

  void main(){
    vec3 viewDir = normalize(cameraPosition - vWorldPos);
    float fres = pow(1.0 - max(dot(normalize(vNormalW), viewDir), 0.0), 2.0);

    vec3 base = uColor;
    if (uHasMap > 0.5){
      vec3 tex = texture2D(uMap, vUv).rgb;
      base = mix(base, base * tex * 1.7, 0.28);
    }

    // Solid jungle fill: the project's green covers the surface, with only a
    // gentle fresnel sheen lifting the grazing edges for form (no white core).
    vec3 col = base + fres * 0.16;
    col += uHover * vec3(0.02, 0.36, 0.5);
    float alpha = uOpacity * (0.92 + fres * 0.08);

    // Dispersion break-up near the plane: punch the surface into sparse motes.
    if (vDisperse > 0.01){
      float n = hash21(vWorldPos.xy * 1.4 + vUv * 24.0 + floor(uTime * 6.0) * 0.17);
      float keep = step(vDisperse * 0.9, n);
      alpha *= mix(1.0, keep, vDisperse);
      col += vDisperse * 0.5 * base;          // motes glow as they scatter
    }

    if (alpha < 0.02) discard;
    gl_FragColor = vec4(col, alpha);
  }
`;

// Every tube/cap shader material is registered so the render loop can advance uTime.
const shaderMats = [];

function makeTubeMaterial(color) {
  const m = new ShaderMaterial({
    uniforms: {
      uTime:     { value: 0 },
      uColor:    { value: color },
      uOpacity:  { value: 1.0 },
      uHover:    { value: 0 },
      uMap:      { value: null },
      uHasMap:   { value: 0 },
      uBandHalf: { value: DISPERSE_BAND },
      uScatter:  { value: DISPERSE_SCATTER },
      uPlaneN:   { value: PLANE_NORMAL },
    },
    vertexShader:   TUBE_VERT,
    fragmentShader: TUBE_FRAG,
    transparent: true,
    depthWrite: true,          // keep occlusion vs. headline + avatar billboards
    side: FrontSide,
    blending: NormalBlending,
  });
  shaderMats.push(m);
  return m;
}

// ── Build project arc tubes ───────────────────────────────────────────────────
const meshGroup = new Group();
scene.add(meshGroup);

const loader   = new TextureLoader();
const meshMeta = [];

projectEls.forEach((el) => {
  const dateStr  = el.dataset.chartDate  || '';
  const duration = parseInt(el.dataset.chartDuration      || '6',  10);
  const collab   = parseInt(el.dataset.chartCollaboration || '50', 10) / 100;
  const medium   = parseInt(el.dataset.chartMedium        || '50', 10) / 100;
  const url      = el.dataset.projectUrl   || '#';
  const title    = el.dataset.projectTitle || '';
  const blendSrc = el.dataset.chartBlend   || null;

  // Collect all per-project image URLs for background strip
  let scrubImages = [];
  try { scrubImages = JSON.parse(el.dataset.chartImages || '[]'); } catch(e) {}

  // ── Radial position ──────────────────────────────────────────────────────
  const r      = R_INNER + collab * (R_OUTER - R_INNER);
  const yElev  = (medium - 0.5) * 2 * Y_RANGE;
  const elapsed    = monthsElapsed(dateStr);
  const thetaStart = THETA_6OCLOCK - elapsed     * RADIANS_PER_MONTH;
  const thetaEnd   = thetaStart    - duration    * RADIANS_PER_MONTH;
  const thetaMid   = (thetaStart + thetaEnd) / 2;

  // ── Tube material — solid jungle-green fill, distinct per project ───────────
  // Derive slug from blend path: /img/chart-blend/<slug>.webp
  const slug = blendSrc ? blendSrc.replace(/^.*\//, '').replace(/\.webp$/, '') : '';
  const projectColor = jungleTubeColor(slug);

  const mat = makeTubeMaterial(projectColor);

  // Load blend image — sampled softly on top of the saturated project color.
  // Textures must be decoded as sRGB (otherwise they render dark), and max
  // anisotropy keeps them sharp where the tube surface grazes the camera.
  if (blendSrc) {
    loader.load(blendSrc, (tex) => {
      tex.colorSpace = SRGBColorSpace;
      tex.anisotropy = maxAniso;
      mat.uniforms.uMap.value    = tex;
      mat.uniforms.uHasMap.value = 1;
      mat.needsUpdate = true;
    });
  }

  // ── Arc tube — smooth round TubeGeometry, densely segmented ─────────────────
  // Higher tubular + radial resolution so the vertex-scatter dispersion near the
  // plane reads as a fine cloud rather than a few chunky facets.
  const arcSegs = Math.max(120, Math.round(ARC_SEGS * (duration / CAREER_MONTHS)) * 6);
  const curve   = makeArcCurve(r, yElev, thetaStart, thetaEnd);
  const tube    = new Mesh(
    new TubeGeometry(curve, arcSegs, TUBE_R, 30, false),
    mat
  );
  tube.userData = { url, title };
  meshGroup.add(tube);

  // ── Spherical endcaps — sealed rounded ends on each tube ────────────────────
  // Replaces the old flat CircleGeometry discs. A sphere at each endpoint gives
  // every arc a rounded terminal that shares the tube's ephemeral shader (so it
  // disperses through the plane too) and its per-project color.
  const capGeo = new SphereGeometry(TUBE_R, 32, 24);
  const capS = new Mesh(capGeo, mat);
  capS.position.copy(circlePoint(r, yElev, thetaStart));
  meshGroup.add(capS);

  const capE = new Mesh(capGeo, mat);
  capE.position.copy(circlePoint(r, yElev, thetaEnd));
  meshGroup.add(capE);

  // Anchor for screen-space tooltip (midpoint above tube)
  const midPt = circlePoint(r, yElev + TUBE_R + 4, thetaMid);
  meshMeta.push({ tube, capS, capE, midPt, url, title, scrubImages, mat, loader });
});

// ── Drag rotation ────────────────────────────────────────────────────────────
let isDragging = false, startX = 0, startY = 0;
let rotX = -5.1, rotY = 38.6;  // dialed-in default view (2026-08-27), read from console during drag
let autoRotate = true;         // idle spin until the first user interaction

function applyGroupRotation() {
  const rx = rotX * Math.PI / 180;
  const ry = rotY * Math.PI / 180;
  meshGroup.rotation.set(rx, ry, 0);
  // Also rotate rings and tick lines
  scene.children.forEach(c => {
    if (c instanceof LineSegments) c.rotation.set(rx, ry, 0);
  });
}

stage.addEventListener('mousedown',  e => { autoRotate = false; isDragging = true; startX = e.clientX; startY = e.clientY; stage.style.cursor = 'grabbing'; });
window.addEventListener('mouseup',   () => {
  const wasDragging = isDragging;
  isDragging = false;
  stage.style.cursor = 'grab';
  if (wasDragging) logCameraPosition('drag-end');  // ← console update on user change, for dialing in defaults
});
window.addEventListener('mousemove', e => {
  if (!isDragging) return;
  rotY += (e.clientX - startX) * 0.35;  // left–right spin only; vertical tilt locked
  startX = e.clientX; startY = e.clientY;
  applyGroupRotation();
});

stage.addEventListener('touchstart', e => {
  autoRotate = false;
  isDragging = true;
  startX = e.touches[0].clientX; startY = e.touches[0].clientY;
}, { passive: true });
window.addEventListener('touchend', () => {
  const wasDragging = isDragging;
  isDragging = false;
  if (wasDragging) logCameraPosition('drag-end');  // ← console update on user change, for dialing in defaults
});
stage.addEventListener('touchmove', e => {
  if (!isDragging) return;
  e.preventDefault();
  rotY += (e.touches[0].clientX - startX) * 0.35;  // left–right spin only
  startX = e.touches[0].clientX; startY = e.touches[0].clientY;
  applyGroupRotation();
}, { passive: false });

// ── Hover: raycaster + headline update + background strip ─────────────────────
const raycaster  = new Raycaster();
const pointerVec = new Vector2();
let hoveredTube  = null;

// Map tube + cap meshes → metadata (so raycaster hits on caps resolve correctly)
const meshToMeta = new Map();
meshMeta.forEach(m => {
  meshToMeta.set(m.tube, m);
  meshToMeta.set(m.capS, m);
  meshToMeta.set(m.capE, m);
});

// Update the headline canvas texture and background strip on hover
function setHoverState(meta) {
  if (headlinePlane && meta) {
    drawHeadlineText(meta.title, true);
  }
  if (bgStrip && meta && meta.scrubImages && meta.scrubImages.length) {
    // Build a horizontal strip of stacked images (screenshot 3 style)
    const imgs = meta.scrubImages.slice(0, 8);
    bgStrip.innerHTML = imgs.map(src =>
      `<img src="${src}" alt="" aria-hidden="true" class="home-axis-bg-img">`
    ).join('');
    bgStrip.style.opacity = '1';
    bgStrip.setAttribute('data-active', meta.title);
  }
}

function clearHoverState() {
  if (headlinePlane) {
    drawHeadlineText(DEFAULT_HEADLINE, false);
  }
  if (bgStrip) {
    bgStrip.style.opacity = '0';
    bgStrip.removeAttribute('data-active');
  }
}

stage.addEventListener('mousemove', e => {
  const rect = stage.getBoundingClientRect();
  const mx   = e.clientX - rect.left;
  const my   = e.clientY - rect.top;
  pointerVec.x =  (mx / rect.width)  * 2 - 1;
  pointerVec.y = -((my / rect.height)) * 2 + 1;
  raycaster.setFromCamera(pointerVec, camera);

  const allMeshes = [...meshToMeta.keys()];
  const hits = raycaster.intersectObjects(allMeshes);

  if (hits.length) {
    const meta = meshToMeta.get(hits[0].object);
    if (!meta) return;

    // Highlight — tube + caps share one shader material, so lift its uHover
    if (hoveredTube !== meta.tube) {
      if (hoveredTube) {
        const prev = meshToMeta.get(hoveredTube);
        if (prev) prev.mat.uniforms.uHover.value = 0;
      }
      hoveredTube = meta.tube;
      meta.mat.uniforms.uHover.value = 1;
      setHoverState(meta);
    }

    if (!isDragging) stage.style.cursor = 'pointer';
  } else {
    if (hoveredTube) {
      const prev = meshToMeta.get(hoveredTube);
      if (prev) prev.mat.uniforms.uHover.value = 0;
      hoveredTube = null;
      clearHoverState();
    }
    if (!isDragging) stage.style.cursor = 'grab';
  }
});

stage.addEventListener('mouseleave', () => {
  if (hoveredTube) {
    const prev = meshToMeta.get(hoveredTube);
    if (prev) prev.mat.uniforms.uHover.value = 0;
    hoveredTube = null;
  }
  clearHoverState();
});

stage.addEventListener('click', () => {
  if (hoveredTube) window.location.href = meshToMeta.get(hoveredTube)?.url || '#';
});

// ── Render loop ───────────────────────────────────────────────────────────────
function animate() {
  requestAnimationFrame(animate);
  // Advance shader time so the dispersion motes + fresnel shimmer animate.
  const t = performance.now() * 0.001;
  for (let i = 0; i < shaderMats.length; i++) shaderMats[i].uniforms.uTime.value = t;
  // Idle auto-rotation — slow left–right spin until the user first interacts.
  if (autoRotate) {
    rotY += 0.12;
    applyGroupRotation();
  }
  // Billboard: headline always faces the camera's view plane, regardless of
  // meshGroup rotation from dragging — copy the camera's world quaternion.
  if (headlinePlane) headlinePlane.quaternion.copy(camera.quaternion);
  renderer.render(scene, camera);
}

// ── Init ──────────────────────────────────────────────────────────────────────
syncSize();
applyGroupRotation();
animate();

// WebGL headline is live — cancel the DOM-headline fallback (see inline script above).
window.__axisReady = true;
if (window.__axisFallbackTimer) window.clearTimeout(window.__axisFallbackTimer);
if (window.__axisRevealHeadline) window.removeEventListener('error', window.__axisRevealHeadline);
if (headlineEl) headlineEl.classList.remove('is-fallback');

window.addEventListener('resize', syncSize, { passive: true });
</script>

