<script type="importmap">
{
  "imports": {
    "three": "https://esm.sh/three@0.169.0"
  }
}
</script>

<script type="module">
import {
  Scene, PerspectiveCamera, WebGLRenderer,
  CapsuleGeometry, SphereGeometry,
  MeshStandardMaterial, MeshBasicMaterial,
  Mesh,
  LineSegments, BufferGeometry, Float32BufferAttribute,
  LineBasicMaterial,
  AmbientLight, DirectionalLight, PointLight,
  TextureLoader,
  Color, Raycaster, Vector2,
  Group
} from 'three';

// ── Guard ────────────────────────────────────────────────────────────────────
const stage      = document.querySelector('[data-axis-stage]');
const canvas     = document.querySelector('[data-axis-canvas]');
const projectEls = Array.from(document.querySelectorAll('[data-axis-project]'));
if (!stage || !canvas || !projectEls.length) throw new Error('[axis] missing DOM');

// ── Renderer ─────────────────────────────────────────────────────────────────
const renderer = new WebGLRenderer({ canvas, antialias: true, alpha: true });
renderer.setClearColor(0x000000, 0);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

function syncSize() {
  const w = stage.clientWidth;
  const h = stage.clientHeight;
  renderer.setSize(w, h, false);
  camera.aspect = w / h;
  camera.updateProjectionMatrix();
}

// ── Scene + Camera ───────────────────────────────────────────────────────────
const scene  = new Scene();
const camera = new PerspectiveCamera(52, 1, 0.1, 2000);
camera.position.set(0, 0, 500);

// ── Lights ───────────────────────────────────────────────────────────────────
scene.add(new AmbientLight(0xffffff, 0.6));

const sun = new DirectionalLight(0xd0eeff, 1.3);
sun.position.set(1, 1.6, 2);
scene.add(sun);

const fill = new PointLight(0x04a5e5, 1.0, 1400);
fill.position.set(-200, 120, 300);
scene.add(fill);

// ── Axis lines through origin ────────────────────────────────────────────────
const AXIS_LEN = 270;
const axisVerts = new Float32Array([
  -AXIS_LEN, 0, 0,   AXIS_LEN, 0, 0,  // X — duration
   0, -AXIS_LEN, 0,  0,  AXIS_LEN, 0, // Y — medium
   0, 0, -AXIS_LEN,  0, 0,  AXIS_LEN, // Z — collaboration
]);
const axisGeo = new BufferGeometry();
axisGeo.setAttribute('position', new Float32BufferAttribute(axisVerts, 3));
scene.add(new LineSegments(axisGeo, new LineBasicMaterial({
  color: 0x9ca0b0, transparent: true, opacity: 0.25
})));

// Origin dot
const originMesh = new Mesh(
  new SphereGeometry(5, 10, 10),
  new MeshBasicMaterial({ color: 0x7287fd, transparent: true, opacity: 0.75 })
);
scene.add(originMesh);

// ── Constants ────────────────────────────────────────────────────────────────
const GOLDEN_ANGLE = Math.PI * (3 - Math.sqrt(5));
const MIN_RADIUS   = 80;
const MAX_RADIUS   = 255;
const MAX_DURATION = 80;
const TUBE_RADIUS  = 5.5;   // capsule tube radius
const MIN_FLAT     = 0;     // flat section for shortest project → pure sphere
const MAX_FLAT     = 200;   // flat section for longest project (80mo)
const SKY          = new Color(0x04a5e5);

// ── Build meshes ─────────────────────────────────────────────────────────────
const loader    = new TextureLoader();
const meshGroup = new Group();
scene.add(meshGroup);

// Store per-mesh metadata for raycasting + title overlay
const meshMeta = [];  // [{ mesh, titleEl, url }]

projectEls.forEach((el, i) => {
  const collab   = parseInt(el.dataset.chartCollaboration || '50', 10) / 100;
  const medium   = parseInt(el.dataset.chartMedium        || '50', 10) / 100;
  const duration = parseInt(el.dataset.chartDuration      || '6',  10);
  const url      = el.dataset.projectUrl || '#';
  const titleEl  = el.querySelector('[data-title-label]');

  // ── 3D position (all radiate from origin) ──────────────────────────────────
  const r     = MIN_RADIUS + collab * (MAX_RADIUS - MIN_RADIUS);
  const theta = i * GOLDEN_ANGLE;
  const phi   = (medium - 0.5) * (Math.PI * 0.72);

  const px = r * Math.cos(phi) * Math.cos(theta);
  const py = r * Math.sin(phi);
  const pz = r * Math.cos(phi) * Math.sin(theta);

  // ── Capsule: lies along X axis, length driven by duration ──────────────────
  const flatLen = MIN_FLAT + (duration / MAX_DURATION) * (MAX_FLAT - MIN_FLAT);
  const geo = new CapsuleGeometry(TUBE_RADIUS, flatLen, 8, 24);

  // Material: sky-blue default, replaced with blurred texture on load
  const mat = new MeshStandardMaterial({
    color: SKY.clone(),
    roughness: 0.40,
    metalness: 0.10,
    transparent: true,
    opacity: 0.80,
  });

  const imgEl  = el.querySelector('.home-axis-dot-img');
  const imgSrc = imgEl ? imgEl.getAttribute('src') : null;
  if (imgSrc) {
    loader.load(imgSrc, (tex) => {
      mat.map = tex;
      mat.color.set(0xffffff);
      mat.roughness = 0.55;
      mat.opacity   = 0.90;
      mat.needsUpdate = true;
    });
  }

  const mesh = new Mesh(geo, mat);

  // CapsuleGeometry is vertical by default; rotate 90° → horizontal (X-axis aligned)
  mesh.rotation.z = Math.PI / 2;

  mesh.position.set(px, py, pz);
  mesh.userData = { url, title: el.dataset.projectTitle || '', index: i };

  meshGroup.add(mesh);
  meshMeta.push({ mesh, titleEl, url });
});

// ── Drag rotation ────────────────────────────────────────────────────────────
let isDragging = false;
let startX = 0, startY = 0;
let rotX = -18, rotY = 12;

function applyGroupRotation() {
  meshGroup.rotation.x = rotX * Math.PI / 180;
  meshGroup.rotation.y = rotY * Math.PI / 180;
  // Also rotate axis lines with the group
  scene.children.forEach(c => {
    if (c instanceof LineSegments) {
      c.rotation.x = rotX * Math.PI / 180;
      c.rotation.y = rotY * Math.PI / 180;
    }
  });
}

stage.addEventListener('mousedown',  e => { isDragging = true; startX = e.clientX; startY = e.clientY; });
window.addEventListener('mouseup',   () => { isDragging = false; });
window.addEventListener('mousemove', e => {
  if (!isDragging) return;
  rotY += (e.clientX - startX) * 0.4;
  rotX -= (e.clientY - startY) * 0.4;
  startX = e.clientX; startY = e.clientY;
  applyGroupRotation();
});

stage.addEventListener('touchstart', e => { isDragging = true; startX = e.touches[0].clientX; startY = e.touches[0].clientY; }, { passive: true });
window.addEventListener('touchend',  () => { isDragging = false; });
window.addEventListener('touchmove', e => {
  if (!isDragging) return;
  rotY += (e.touches[0].clientX - startX) * 0.4;
  rotX -= (e.touches[0].clientY - startY) * 0.4;
  startX = e.touches[0].clientX; startY = e.touches[0].clientY;
  applyGroupRotation();
}, { passive: true });

// ── Hover via raycaster ───────────────────────────────────────────────────────
const raycaster   = new Raycaster();
const pointerVec  = new Vector2();
let hoveredMesh   = null;

stage.addEventListener('mousemove', e => {
  const rect = stage.getBoundingClientRect();
  pointerVec.x =  ((e.clientX - rect.left) / rect.width)  * 2 - 1;
  pointerVec.y = -((e.clientY - rect.top)  / rect.height) * 2 + 1;
  raycaster.setFromCamera(pointerVec, camera);
  const hits = raycaster.intersectObjects(meshGroup.children);
  if (hits.length) {
    const h = hits[0].object;
    if (h !== hoveredMesh) {
      if (hoveredMesh) hoveredMesh.material.emissiveIntensity = 0;
      hoveredMesh = h;
      hoveredMesh.material.emissive = new Color(0x04a5e5);
      hoveredMesh.material.emissiveIntensity = 0.3;
      stage.style.cursor = 'pointer';
    }
  } else {
    if (hoveredMesh) { hoveredMesh.material.emissiveIntensity = 0; hoveredMesh = null; }
    stage.style.cursor = 'grab';
  }
});

stage.addEventListener('click', e => {
  if (hoveredMesh) window.location.href = hoveredMesh.userData.url;
});

// ── Title overlay projection ──────────────────────────────────────────────────
function projectToScreen(worldPos) {
  const v = worldPos.clone().project(camera);
  const rect = stage.getBoundingClientRect();
  return {
    x: ( v.x * 0.5 + 0.5) * rect.width,
    y: (-v.y * 0.5 + 0.5) * rect.height,
  };
}

// ── Render loop ───────────────────────────────────────────────────────────────
function animate() {
  requestAnimationFrame(animate);

  // Update title label positions each frame
  meshMeta.forEach(({ mesh, titleEl }) => {
    if (!titleEl) return;
    const screen = projectToScreen(mesh.position.clone().applyEuler(meshGroup.rotation));
    titleEl.style.left = screen.x + 'px';
    titleEl.style.top  = (screen.y - TUBE_RADIUS - 18) + 'px';
  });

  renderer.render(scene, camera);
}

// ── Init ──────────────────────────────────────────────────────────────────────
syncSize();
applyGroupRotation();
animate();

window.addEventListener('resize', syncSize, { passive: true });
</script>

{% endif %}

{{ content | safe }}
