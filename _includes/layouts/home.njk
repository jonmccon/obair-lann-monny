---
layout: layouts/base.njk
---
{% if page.url == "/" %}
{% set homeOptions = home | default({}) %}
{% set introductionHeading = homeOptions.introductionHeading | default(profile.headline) %}
{% set introductionText = homeOptions.introductionText | default(profile.aboutBio) %}
{% set featuredProjectThumbnailLimit = homeOptions.featuredProjectThumbnailLimit | default(10) %}
{% set homeContactLinks = homeOptions.contactLinks | default([
  { title: "jonmccon@gmail.com", url: "https://mail.google.com/mail/?view=cm&fs=1&to=jonmccon@gmail.com", icon: "mail", external: true },
  { title: "GitHub", url: "https://github.com/jonmccon", icon: "github" },
  { title: "LinkedIn", url: "https://www.linkedin.com/in/jonmccon", icon: "linkedin" }
]) %}

<section class="homepage-axis-hero" aria-label="Homepage hero">
  <div class="home-axis-stage" data-axis-stage>
    {# Canvas target for Three.js WebGL renderer #}
    <canvas class="home-axis-canvas" data-axis-canvas aria-hidden="true"></canvas>

    {# Axis labels — positioned by CSS over the canvas #}
    <div class="home-axis-labels" aria-hidden="true">
      <span class="home-axis-label home-axis-label-x">duration ←→</span>
      <span class="home-axis-label home-axis-label-y">technical ↔ visual</span>
      <span class="home-axis-label home-axis-label-z">solo ↔ team</span>
    </div>

    {# Project data + title overlays — invisible data carriers, titles shown via JS screen-projection #}
    {% for post in collections.featuredProjects | reverse %}
    {% if loop.index <= featuredProjectThumbnailLimit %}
    {%- set _duration = post.data.chart.duration | default(6) -%}
    <article class="home-axis-project" data-axis-project
      data-project-index="{{ loop.index0 }}"
      data-project-title="{{ post.data.pageHeadline }}"
      data-project-url="{{ post.url }}"
      data-project-tags="{{ (post.data.tags | filterTagList | join(',')) | lower }}"
      data-chart-date="{{ post.date | htmlDateString }}"
      data-chart-duration="{{ _duration }}"
      data-chart-collaboration="{{ post.data.chart.collaboration | default(50) }}"
      data-chart-medium="{{ post.data.chart.medium | default(50) }}"
      data-chart-blend="/img/chart-blend/{{ post.fileSlug }}.webp"
      aria-label="{{ post.data.title }}">
      {# Hidden image — src read by Three.js texture loader #}
      {% if post.data.images and post.data.images.length %}
        {% homepageImage post.data.images[0].src, post.data.pageHeadline, 80, "home-axis-dot-img" %}
      {% endif %}
      {# Title label — positioned absolutely via JS screen-projection each frame #}
      <a class="home-axis-project-title-label" href="{{ post.url }}" data-title-label>{{ post.data.pageHeadline }}</a>
    </article>
    {% endif %}
    {% endfor %}
  </div>
</section>

<div class="home-chart-attribution">
  <div class="home-center-lockup">
    {% if introductionHeading %}<h1 class="homepage-headline-axis">{{ introductionHeading }}</h1>{% endif %}
    <div class="homepage-main-avatar homepage-main-avatar-overlay">
      {% image profile.portraitUrl, "Jonny McConnell portrait", [240], "240px" %}
    </div>
  </div>
</div>

