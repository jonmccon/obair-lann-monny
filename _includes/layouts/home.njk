    { url: "/design/resonance-ai-ml-platform/", quote: "Reduced report task time by 95%", source: "Resonance AI" },
    { url: "/design/priority-tax-relief/", quote: "Conversion surfaces up by 14×", source: "Priority Tax Relief" },
    { url: "/design/lumedic-platform-healthcare-records/", quote: "Thousands of workers verified daily", source: "Lumedic Connect" },
    { url: "/design/seattle-creative-directory/", quote: "268 listings · 15 episodes · 50k+ plays", source: "Seattle Creative Directory" },
    { url: "/design/android-gemini-interaction/", quote: "Interaction patterns surfaced in Gemini for Android", source: "BUCK × Google — early Gemini concepts" }
  ] %}
