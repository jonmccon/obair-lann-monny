---
layout: layouts/base.njk
---
{% if page.url == "/" %}
{% set homeOptions = home | default({}) %}
{% set introductionHeading = homeOptions.introductionHeading | default(profile.headline) %}
{% set introductionText = homeOptions.introductionText | default(profile.aboutBio) %}
{% set featuredProjectThumbnailLimit = homeOptions.featuredProjectThumbnailLimit | default(10) %}
{% set homeContactLinks = homeOptions.contactLinks | default([
  { title: "jonmccon@gmail.com", url: "https://mail.google.com/mail/?view=cm&fs=1&to=jonmccon@gmail.com", icon: "mail", external: true },
  { title: "GitHub", url: "https://github.com/jonmccon", icon: "github" },
  { title: "LinkedIn", url: "https://www.linkedin.com/in/jonmccon", icon: "linkedin" }
]) %}

<section class="homepage-axis-hero" aria-label="Homepage hero">
  <div class="home-axis-stage" data-axis-stage>
    <div class="home-axis-grid" aria-hidden="true">
      <span class="home-axis-line home-axis-line-x"></span>
      <span class="home-axis-line home-axis-line-y"></span>
      <span class="home-axis-line home-axis-line-z"></span>
      <span class="home-axis-origin-point"></span>
      <span class="home-axis-label home-axis-label-x">technology</span>
      <span class="home-axis-label home-axis-label-y">human behavior</span>
      <span class="home-axis-label home-axis-label-z">product strategy</span>
    </div>

    <div class="home-center-lockup">
      {% if introductionHeading %}<h1 class="homepage-headline-axis">{{ introductionHeading }}</h1>{% endif %}
      <div class="homepage-main-avatar homepage-main-avatar-overlay">
        {% image profile.portraitUrl, "Jonny McConnell portrait", [240], "240px" %}
      </div>
    </div>

    {% for post in collections.featuredProjects | reverse %}
    {% if loop.index <= featuredProjectThumbnailLimit and post.data.images and post.data.images.length %}
    <article class="home-axis-project" data-axis-project data-project-index="{{ loop.index0 }}" data-project-title="{{ post.data.title | slugify }}" data-project-tags="{{ (post.data.tags | filterTagList | join(',')) | lower }}">
      <a class="home-axis-project-link" href="{{ post.url }}" aria-label="{{ post.data.title }}">
        <div class="home-axis-pile" data-image-count="{{ post.data.images.length }}">
          {% for img in post.data.images | head(4) %}
          <div class="home-axis-pile-image" data-layer-index="{{ loop.index0 }}" style="--z-index: {{ 10 - loop.index0 }};">
            {% homepageImage img.src, img.alt | default(post.data.title), 360, "home-axis-pile-img" %}
          </div>
          {% endfor %}
        </div>
        <span class="home-axis-project-title">{{ post.data.title }}</span>
      </a>
    </article>
    {% endif %}
    {% endfor %}
    <div class="home-see-all-link">
      <a href="/design/">
        <span>See all work</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<section class="home-supporting-content" aria-label="Homepage supporting content">
  {% if introductionText %}
  <p class="homepage-about">{{ introductionText }}</p>
  {% endif %}
  <section class="home-supporting-media" aria-label="Podcast appearances and tools">
    <div class="home-supporting-media-grid">
      <article class="home-supporting-media-card">
        <h2 class="home-supporting-media-title">Podcasts</h2>
        <p class="home-supporting-media-text">Recent conversations on design systems, product strategy, and building thoughtful tools.</p>
        <iframe class="home-supporting-player" height="200" width="100%" frameborder="no" scrolling="no" seamless src="https://player.simplecast.com/9fc38fe1-df84-4a61-8348-b4a888606182?dark=false" title="Simplecast podcast player 1"></iframe>
        <iframe class="home-supporting-player" height="200" width="100%" frameborder="no" scrolling="no" seamless src="https://player.simplecast.com/a8c63034-9b6c-4d56-b3ed-e440f6a3e031?dark=false" title="Simplecast podcast player 2"></iframe>
      </article>
      <article class="home-supporting-feature" aria-label="Featured tool">
        <div class="home-supporting-feature-image" aria-hidden="true">
          <span class="home-supporting-feature-image-mark">TB</span>
        </div>
        <div class="home-supporting-feature-copy">
          <h2 class="home-supporting-media-title">Featured Tool</h2>
          <h3 class="home-supporting-feature-heading">Obsidian Time Blocks Plugin</h3>
          <p class="home-supporting-feature-text">A lightweight bookmark for planning focused work in Obsidian with a simple time-blocking workflow.</p>
          <a class="home-supporting-link" href="https://community.obsidian.md/plugins/time-blocks" target="_blank" rel="noreferrer">Open plugin page</a>
        </div>
      </article>
    </div>
  </section>
  <div class="home-supporting-links home-supporting-links-footer" aria-label="Supporting links">
    {% for link in homeContactLinks %}
    <a class="home-supporting-link home-supporting-link-footer" href="{{ link.url }}"{% if link.external %} target="_blank" rel="noreferrer"{% endif %}>
      <span class="home-supporting-link-icon" aria-hidden="true">
        {% if link.icon == "mail" %}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5v10.5H3.75z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 7.5 7.5 6 7.5-6" />
        </svg>
        {% elif link.icon == "github" %}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 .5C5.65.5.5 5.8.5 12.35c0 5.24 3.3 9.68 7.88 11.25.57.11.78-.25.78-.56 0-.28-.01-1.2-.02-2.18-3.2.71-3.88-1.4-3.88-1.4-.52-1.37-1.28-1.74-1.28-1.74-1.05-.74.08-.73.08-.73 1.16.08 1.77 1.23 1.77 1.23 1.03 1.82 2.7 1.29 3.36.99.1-.77.4-1.29.72-1.59-2.56-.3-5.26-1.32-5.26-5.9 0-1.31.46-2.37 1.22-3.2-.12-.31-.53-1.56.12-3.25 0 0 1-.33 3.3 1.22a11.2 11.2 0 0 1 6 0c2.29-1.55 3.29-1.22 3.29-1.22.66 1.69.25 2.94.12 3.25.76.83 1.22 1.89 1.22 3.2 0 4.59-2.7 5.6-5.28 5.9.42.37.79 1.08.79 2.19 0 1.58-.01 2.85-.01 3.24 0 .31.2.68.79.56A11.88 11.88 0 0 0 23.5 12.35C23.5 5.8 18.35.5 12 .5Z" />
        </svg>
        {% elif link.icon == "linkedin" %}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
          <path d="M4.98 3.5a1.73 1.73 0 1 1 0 3.46 1.73 1.73 0 0 1 0-3.46ZM3.5 8.25h2.96V20.5H3.5V8.25Zm5.31 0h2.84v1.67h.04c.4-.75 1.36-1.94 3.15-1.94 3.37 0 3.99 2.28 3.99 5.24v7.28h-2.96v-6.45c0-1.54-.03-3.52-2.08-3.52-2.08 0-2.4 1.67-2.4 3.4v6.57H8.81V8.25Z" />
        </svg>
        {% endif %}
      </span>
      <span>{{ link.title }}</span>
    </a>
    {% endfor %}
  </div>
</section>

{% if collections.semiFeaturedProjects.length > 0 %}
<section class="home-semi-featured-grid" aria-label="Selected work">
  <div class="thumb-grid">
    {% for post in collections.semiFeaturedProjects | reverse %}
      {% if loop.index <= 6 %}
        {% if post.data.thumbnail %}
          <a href="{{ post.url }}" class="thumb-grid-item">
            <img src="{{ post.data.thumbnail }}" alt="{{ post.data.title }}" loading="lazy" decoding="async" width="300" height="300">
            <span class="thumb-grid-title">{{ post.data.title }}</span>
          </a>
        {% else %}
          {# Fallback: use first processed image from collections.images #}
          {% set thumbnail = "" %}
          {% for image in collections.images %}
            {% if image.url == post.url and thumbnail == "" %}
              {% set thumbnail = image.src %}
            {% endif %}
          {% endfor %}
          {% if thumbnail %}
            <a href="{{ post.url }}" class="thumb-grid-item">
              <img src="{{ thumbnail }}" alt="{{ post.data.title }}" loading="lazy" decoding="async">
              <span class="thumb-grid-title">{{ post.data.title }}</span>
            </a>
          {% endif %}
        {% endif %}
      {% endif %}
    {% endfor %}
  </div>
  

</section>
{% endif %}

<script>
(function() {
  'use strict';

  const stage = document.querySelector('[data-axis-stage]');
  const projects = Array.from(document.querySelectorAll('[data-axis-project]'));

  if (!stage || !projects.length) {
    return;
  }

  // Logical plot resolution for placement (not CSS pixels).
  const GRID_COLUMNS = 24;
  const GRID_ROWS = 16;
  // Keep a no-fly zone around headline/avatar so piles orbit the center.
  const HERO_BLOCK_COL_MIN = 7;
  const HERO_BLOCK_COL_MAX = 18;
  const HERO_BLOCK_ROW_MIN = 4;
  const HERO_BLOCK_ROW_MAX = 13;
  // Mobile uses a simplified placement pattern for readability/perf.
  const MOBILE_BREAKPOINT = 768;
  // Hash scale used to derive deterministic pseudo-random jitter.
  const HASH_MULTIPLIER = 10000;

  // Tags that contribute to each axis score.
  const HUMAN_TAGS = new Set(['community', 'branding', 'healthcare', 'event', 'education', 'consumer']);
  const TECH_TAGS = new Set(['web', 'mobile', 'system', 'ai', 'prototype', 'engineering']);
  const STRATEGY_TAGS = new Set(['product', 'ux', 'service', 'workflow', 'platform']);
  // Axis-biased cluster anchors in normalized chart space (0..1, 0..1).
  const CLUSTER_CENTROIDS = {
    human: { x: 0.23, y: 0.74 },
    technology: { x: 0.78, y: 0.24 },
    strategy: { x: 0.73, y: 0.72 },
    balanced: { x: 0.52, y: 0.52 }
  };

  function hash(seed) {
    const x = Math.sin(seed) * HASH_MULTIPLIER;
    return x - Math.floor(x);
  }

  function scoreAxes(tags) {
    let human = 0;
    let technology = 0;
    let strategy = 0;

    tags.forEach((tag) => {
      if (HUMAN_TAGS.has(tag)) {
        human += 1.15;
      }
      if (TECH_TAGS.has(tag)) {
        technology += 1.2;
      }
      if (STRATEGY_TAGS.has(tag)) {
        strategy += 1.1;
      }
    });

    return { human, technology, strategy };
  }

  function clamp(value, min, max) {
    return Math.min(max, Math.max(min, value));
  }

  // Push normalized coordinates away from center while preserving side/quadrant.
  function pushAwayFromCenter(value, strength) {
    const delta = value - 0.5;
    const direction = delta === 0 ? 1 : Math.sign(delta);
    // Slightly stronger push when already farther out.
    const distanceWeight = 0.42 + Math.abs(delta);
    return clamp(value + (direction * strength * distanceWeight), 0.03, 0.97);
  }

  // Select the strongest semantic axis for centroid pull.
  function getDominantAxis(human, technology, strategy) {
    const maxValue = Math.max(human, technology, strategy);
    if (maxValue <= 0) {
      return 'balanced';
    }
    if (human === technology && technology === strategy) {
      return 'balanced';
    }
    if (maxValue === human) {
      return 'human';
    }
    if (maxValue === technology) {
      return 'technology';
    }
    return 'strategy';
  }

  function findAvailableCell(baseCol, baseRow, occupied) {
    // Spiral-like local search around target to avoid collisions.
    const searchSteps = [
      [0, 0], [1, 0], [-1, 0], [0, 1], [0, -1],
      [2, 0], [-2, 0], [0, 2], [0, -2],
      [1, 1], [1, -1], [-1, 1], [-1, -1],
      [3, 1], [-3, -1], [2, -2], [-2, 2]
    ];

    for (const [dc, dr] of searchSteps) {
      const col = clamp(baseCol + dc, 1, GRID_COLUMNS);
      const row = clamp(baseRow + dr, 1, GRID_ROWS);
      const key = `${col}-${row}`;
      // Reject cells overlapping the hero lockup region.
      const inCenterBlock = col >= HERO_BLOCK_COL_MIN && col <= HERO_BLOCK_COL_MAX && row >= HERO_BLOCK_ROW_MIN && row <= HERO_BLOCK_ROW_MAX;
      if (!occupied.has(key) && !inCenterBlock) {
        occupied.add(key);
        return { col, row };
      }
    }

    return { col: baseCol, row: baseRow };
  }

  function placeProjects() {
    const isMobile = window.matchMedia(`(max-width: ${MOBILE_BREAKPOINT}px)`).matches;

    if (isMobile) {
      // Lightweight deterministic mobile layout: alternate left/right columns.
      projects.forEach((project, idx) => {
        project.style.setProperty('--axis-col', idx % 2 === 0 ? 3 : 22);
        project.style.setProperty('--axis-row', 10 - Math.floor(idx / 2) * 2);
      });
      return;
    }

    const occupied = new Set();

    projects.forEach((project, idx) => {
      const titleSeed = project.dataset.projectTitle || String(idx);
      const tags = (project.dataset.projectTags || '').split(',').map((tag) => tag.trim()).filter(Boolean);
      const { human, technology, strategy } = scoreAxes(tags);

      // Stable jitter from title/index so the layout stays consistent across loads.
      const seed = titleSeed.length * 17 + idx * 31;
      const jitterX = (hash(seed + 3) - 0.5) * 0.09;
      const jitterY = (hash(seed + 7) - 0.5) * 0.09;
      // Z jitter nudges both axes slightly to avoid rigid lines.
      const jitterZ = (hash(seed + 11) - 0.5) * 0.1;

      // Normalize score magnitudes to proportions per project.
      const totalScore = Math.max(1, human + technology + strategy);
      const humanRatio = human / totalScore;
      const techRatio = technology / totalScore;
      const strategyRatio = strategy / totalScore;

      // Base semantic vector: tech/strategy affect X, human/strategy affect Y.
      const vectorX = 0.1 + (techRatio * 0.58) + (strategyRatio * 0.34) + (jitterZ * 0.18);
      const vectorY = 0.11 + (humanRatio * 0.58) + (strategyRatio * 0.34) + (jitterZ * 0.18);

      // Blend with dominant-axis centroid for clearer cluster identity.
      const dominantAxis = getDominantAxis(human, technology, strategy);
      const centroid = CLUSTER_CENTROIDS[dominantAxis] || CLUSTER_CENTROIDS.balanced;
      const baseX = clamp((vectorX * 0.66) + (centroid.x * 0.34) + jitterX, 0.04, 0.95);
      const baseY = clamp((vectorY * 0.66) + (centroid.y * 0.34) + jitterY, 0.05, 0.95);
      // Final spread control: pushes clusters farther from center lockup.
      const xNormalized = pushAwayFromCenter(baseX, 0.42);
      const yNormalized = pushAwayFromCenter(baseY, 0.42);

      // Convert normalized coordinates to discrete grid cells.
      const baseCol = clamp(Math.round(xNormalized * (GRID_COLUMNS - 1)) + 1, 1, GRID_COLUMNS);
      // Invert Y so higher normalized values map visually upward from origin.
      const baseRow = clamp(GRID_ROWS - Math.round(yNormalized * (GRID_ROWS - 1)), 1, GRID_ROWS);
      const { col, row } = findAvailableCell(baseCol, baseRow, occupied);

      project.style.setProperty('--axis-col', String(col));
      project.style.setProperty('--axis-row', String(row));
    });
  }

  function updatePileTransforms(pile, pileSeed) {
    const frames = Array.from(pile.querySelectorAll('.home-axis-pile-image'));
    frames.forEach((frame, idx) => {
      const seed = pileSeed + idx * 29;
      // Per-card transform controls for each mini-pile stack.
      const rotation = -10 + hash(seed + 1) * 20;
      const scale = 0.78 + hash(seed + 2) * 0.26;
      const width = 56 + hash(seed + 3) * 22;
      const height = 54 + hash(seed + 4) * 18;
      const offsetX = -18 + hash(seed + 5) * 36;
      const offsetY = -14 + hash(seed + 6) * 28;

      frame.style.setProperty('--rotation', `${rotation.toFixed(2)}deg`);
      frame.style.setProperty('--scale', scale.toFixed(3));
      frame.style.setProperty('--w', `${width.toFixed(1)}%`);
      frame.style.setProperty('--h', `${height.toFixed(1)}%`);
      frame.style.setProperty('--offset-x', `${offsetX.toFixed(1)}px`);
      frame.style.setProperty('--offset-y', `${offsetY.toFixed(1)}px`);
    });
  }

  projects.forEach((project, idx) => {
    const pile = project.querySelector('.home-axis-pile');
    if (pile) {
      updatePileTransforms(pile, (idx + 1) * 97);
    }
  });

  placeProjects();
  window.addEventListener('resize', placeProjects, { passive: true });
})();
</script>

{% endif %}

{{ content | safe }}
