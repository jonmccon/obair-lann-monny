<script type="importmap">
{
  "imports": {
    "three": "https://esm.sh/three@0.169.0"
  }
}
</script>

<script type="module">
import {
  Scene, PerspectiveCamera, WebGLRenderer,
  TubeGeometry, CatmullRomCurve3,
  SphereGeometry,
  MeshStandardMaterial, MeshBasicMaterial,
  Mesh,
  LineSegments, BufferGeometry, Float32BufferAttribute,
  LineBasicMaterial,
  AmbientLight, DirectionalLight, PointLight,
  TextureLoader,
  Color, Raycaster, Vector2, Vector3,
  Group
} from 'three';

// ── Guard ────────────────────────────────────────────────────────────────────
const stage      = document.querySelector('[data-axis-stage]');
const canvas     = document.querySelector('[data-axis-canvas]');
const projectEls = Array.from(document.querySelectorAll('[data-axis-project]'));
if (!stage || !canvas || !projectEls.length) throw new Error('[axis] missing DOM');

// ── Renderer ─────────────────────────────────────────────────────────────────
const renderer = new WebGLRenderer({ canvas, antialias: true, alpha: true });
renderer.setClearColor(0x000000, 0);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

function syncSize() {
  const w = stage.clientWidth;
  const h = stage.clientHeight;
  renderer.setSize(w, h, false);
  camera.aspect = w / h;
  camera.updateProjectionMatrix();
}

// ── Scene + Camera ───────────────────────────────────────────────────────────
const scene  = new Scene();
const camera = new PerspectiveCamera(52, 1, 0.1, 2000);
camera.position.set(0, 60, 560);
camera.lookAt(0, 0, 0);

// ── Lights ───────────────────────────────────────────────────────────────────
scene.add(new AmbientLight(0xffffff, 0.55));

const sun = new DirectionalLight(0xd0eeff, 1.3);
sun.position.set(1.2, 2, 1.5);
scene.add(sun);

const fill = new PointLight(0x04a5e5, 1.1, 1600);
fill.position.set(-220, 140, 340);
scene.add(fill);

// ── Radial chart constants ───────────────────────────────────────────────────
//
// Clock face lies in the XZ plane (Y = 0 baseline).
// Camera at (0, 60, 560) looks slightly down onto the clock face.
//
// Timeline: 6 o'clock (bottom, -Z) = Jan 2010, sweeps clockwise.
// In Three.js XZ plane (Y=0), clock geometry uses:
//   angle 0   = +X  (3 o'clock)
//   angle π   = -X  (9 o'clock)
//   angle -π/2 = -Z (12 o'clock from camera view, used as 6 o'clock "bottom")
// Wait — camera is at +Z so bottom of viewport = -Y direction.
// The clock face is XY plane. 6 o'clock = -Y. Clockwise: angle decreases.
// x = R*cos(θ), y = R*sin(θ), z = elevation (medium axis)

const CAREER_START_YEAR  = 2010;
const CAREER_START_MONTH = 1;
const CAREER_END_YEAR    = 2026;
const CAREER_END_MONTH   = 8;
const CAREER_MONTHS      = (CAREER_END_YEAR - CAREER_START_YEAR) * 12
                           + (CAREER_END_MONTH - CAREER_START_MONTH); // 199

const RADIANS_PER_MONTH = (2 * Math.PI) / CAREER_MONTHS;
const THETA_6OCLOCK     = -Math.PI / 2;   // bottom of clock (−Y axis), career start

// ── Chart geometry dimensions ─────────────────────────────────────────────────
const R_INNER  = 70;    // solo projects (collaboration=0) radius
const R_OUTER  = 200;   // team projects (collaboration=100) radius — compact
const Y_RANGE  = 180;   // ± elevation above/below clock plane (medium axis depth)
const TUBE_R   = 16;    // tube cross-section radius — beefy 3D pill
const ARC_SEGS = 72;    // points along arc curve

const SKY = new Color(0x04a5e5);

// ── Helper: months since career start ────────────────────────────────────────
function monthsElapsed(dateStr) {
  if (!dateStr) return 0;
  const parts = dateStr.split('-');
  const y = parseInt(parts[0], 10);
  const m = parseInt(parts[1], 10);
  return Math.max(0, (y - CAREER_START_YEAR) * 12 + (m - CAREER_START_MONTH));
}

// ── Helper: build arc curve in XY plane at a given R, Y elevation ─────────
// θ_start, θ_end in radians (clockwise = decreasing)
// Returns CatmullRomCurve3 of points for TubeGeometry
function makeArcCurve(r, yElev, thetaStart, thetaEnd) {
  const pts = [];
  const n   = ARC_SEGS;
  for (let i = 0; i <= n; i++) {
    const t   = i / n;
    const ang = thetaStart + t * (thetaEnd - thetaStart);
    pts.push(new Vector3(
      r * Math.cos(ang),
      yElev,
      r * Math.sin(ang)
    ));
  }
  return new CatmullRomCurve3(pts, false, 'catmullrom', 0.0);
}

// ── Axis reference rings ──────────────────────────────────────────────────────
// Two faint circles at R_INNER and R_OUTER to show the collaboration axis range
function makeRingVerts(r, segments = 128) {
  const verts = [];
  for (let i = 0; i <= segments; i++) {
    const a  = (i / segments) * 2 * Math.PI;
    const a2 = ((i + 1) / segments) * 2 * Math.PI;
    verts.push(r * Math.cos(a), 0, r * Math.sin(a));
    verts.push(r * Math.cos(a2), 0, r * Math.sin(a2));
  }
  return new Float32Array(verts);
}

const ringMat = new LineBasicMaterial({ color: 0x7287fd, transparent: true, opacity: 0.12 });
for (const r of [R_INNER, (R_INNER + R_OUTER) / 2, R_OUTER]) {
  const rg = new BufferGeometry();
  rg.setAttribute('position', new Float32BufferAttribute(makeRingVerts(r), 3));
  scene.add(new LineSegments(rg, ringMat.clone()));
}

// 12/6 o'clock tick line (vertical — shows career start direction)
const tickVerts = new Float32Array([
  0, 0, -R_OUTER * 1.05,
  0, 0,  R_OUTER * 1.05,
]);
const tickGeo = new BufferGeometry();
tickGeo.setAttribute('position', new Float32BufferAttribute(tickVerts, 3));
scene.add(new LineSegments(tickGeo, new LineBasicMaterial({ color: 0x9ca0b0, transparent: true, opacity: 0.15 })));

// Origin dot
scene.add(new Mesh(
  new SphereGeometry(4, 10, 10),
  new MeshBasicMaterial({ color: 0x7287fd, transparent: true, opacity: 0.7 })
));

// ── Build project arc tubes ───────────────────────────────────────────────────
const loader    = new TextureLoader();
const meshGroup = new Group();
scene.add(meshGroup);

const meshMeta = [];

projectEls.forEach((el) => {
  const dateStr  = el.dataset.chartDate || '';
  const duration = parseInt(el.dataset.chartDuration      || '6',  10);
  const collab   = parseInt(el.dataset.chartCollaboration || '50', 10) / 100;
  const medium   = parseInt(el.dataset.chartMedium        || '50', 10) / 100;
  const url      = el.dataset.projectUrl  || '#';
  const titleEl  = el.querySelector('[data-title-label]');

  // ── Radial position ──────────────────────────────────────────────────────
  // R: collaboration — solo (0) = inner ring, team (1) = outer ring
  const r = R_INNER + collab * (R_OUTER - R_INNER);

  // Y elevation: medium — technical (0) = slightly below plane, visual (1) = above
  const yElev = (medium - 0.5) * 2 * Y_RANGE;

  // ── Angular position (clock face) ────────────────────────────────────────
  // θ_start: where this project starts on the clock
  // Clockwise from 6 o'clock → decreasing angle
  const elapsed    = monthsElapsed(dateStr);
  const thetaStart = THETA_6OCLOCK - elapsed * RADIANS_PER_MONTH;
  const thetaEnd   = thetaStart    - duration * RADIANS_PER_MONTH;

  // ── Geometry: arc tube ───────────────────────────────────────────────────
  // arcSegs: minimum 16 for short projects, scales with duration for long arcs
  const arcSegs  = Math.max(16, Math.round(ARC_SEGS * (duration / CAREER_MONTHS)));
  const curve    = makeArcCurve(r, yElev, thetaStart, thetaEnd);
  const tubeGeo  = new TubeGeometry(curve, arcSegs, TUBE_R, 20, false);  // 20 radial segs = smooth pill

  // ── Material ──────────────────────────────────────────────────────────────
  const mat = new MeshStandardMaterial({
    color: SKY.clone(),
    roughness: 0.42,
    metalness: 0.10,
    transparent: true,
    opacity: 0.85,
  });

  // Prefer the pre-built blended texture; fall back to first project image
  const blendSrc = el.dataset.chartBlend || null;
  const imgEl    = el.querySelector('.home-axis-dot-img');
  const imgSrc   = blendSrc || (imgEl ? imgEl.getAttribute('src') : null);

  if (imgSrc) {
    loader.load(imgSrc, (tex) => {
      mat.map      = tex;
      mat.color.set(0xffffff);
      mat.roughness = 0.52;
      mat.opacity   = 0.90;
      mat.needsUpdate = true;
    });
  }

  const mesh = new Mesh(tubeGeo, mat);
  mesh.userData = { url, title: el.dataset.projectTitle || '', elapsed, duration, r, yElev };

  meshGroup.add(mesh);

  // Title anchor: midpoint of the arc
  const thetaMid = (thetaStart + thetaEnd) / 2;
  const titleAnchor = new Vector3(
    r * Math.cos(thetaMid),
    yElev + TUBE_R + 2,
    r * Math.sin(thetaMid)
  );
  meshMeta.push({ mesh, titleEl, url, titleAnchor });
});

// ── Drag rotation ────────────────────────────────────────────────────────────
let isDragging = false;
let startX = 0, startY = 0;
let rotX = -22, rotY = 0;   // angled view — show both the clock face and Y depth

function applyGroupRotation() {
  // No clamp — full freedom to explore all angles
  meshGroup.rotation.x = rotX * Math.PI / 180;
  meshGroup.rotation.y = rotY * Math.PI / 180;
  scene.children.forEach(c => {
    if (c instanceof LineSegments) {
      c.rotation.x = rotX * Math.PI / 180;
      c.rotation.y = rotY * Math.PI / 180;
    }
  });
}

stage.addEventListener('mousedown',  e => { isDragging = true; startX = e.clientX; startY = e.clientY; stage.style.cursor = 'grabbing'; });
window.addEventListener('mouseup',   () => { isDragging = false; stage.style.cursor = 'grab'; });
window.addEventListener('mousemove', e => {
  if (!isDragging) return;
  rotY += (e.clientX - startX) * 0.35;
  rotX -= (e.clientY - startY) * 0.35;
  startX = e.clientX; startY = e.clientY;
  applyGroupRotation();
});

// Touch: capture touchmove on the stage to prevent page scroll while dragging the chart
stage.addEventListener('touchstart', e => {
  isDragging = true;
  startX = e.touches[0].clientX;
  startY = e.touches[0].clientY;
}, { passive: true });

window.addEventListener('touchend',  () => { isDragging = false; });

// Non-passive so we can call preventDefault() to block scroll while dragging
stage.addEventListener('touchmove', e => {
  if (!isDragging) return;
  e.preventDefault();   // ← prevents page scroll while rotating the chart
  rotY += (e.touches[0].clientX - startX) * 0.35;
  rotX -= (e.touches[0].clientY - startY) * 0.35;
  startX = e.touches[0].clientX;
  startY = e.touches[0].clientY;
  applyGroupRotation();
}, { passive: false });  // ← must be non-passive to allow preventDefault

// ── Hover via raycaster ───────────────────────────────────────────────────────
const raycaster  = new Raycaster();
const pointerVec = new Vector2();
let hoveredMesh  = null;

stage.addEventListener('mousemove', e => {
  const rect = stage.getBoundingClientRect();
  pointerVec.x =  ((e.clientX - rect.left) / rect.width)  * 2 - 1;
  pointerVec.y = -((e.clientY - rect.top)  / rect.height) * 2 + 1;
  raycaster.setFromCamera(pointerVec, camera);
  const hits = raycaster.intersectObjects(meshGroup.children);
  if (hits.length) {
    const h = hits[0].object;
    if (h !== hoveredMesh) {
      if (hoveredMesh) hoveredMesh.material.emissiveIntensity = 0;
      hoveredMesh = h;
      hoveredMesh.material.emissive = new Color(0x04a5e5);
      hoveredMesh.material.emissiveIntensity = 0.35;
      if (!isDragging) stage.style.cursor = 'pointer';
    }
  } else {
    if (hoveredMesh) { hoveredMesh.material.emissiveIntensity = 0; hoveredMesh = null; }
    if (!isDragging) stage.style.cursor = 'grab';
  }
});

stage.addEventListener('click', () => {
  if (hoveredMesh) window.location.href = hoveredMesh.userData.url;
});

// ── Screen-space projection for title labels ──────────────────────────────────
function toScreen(worldPos) {
  const v    = worldPos.clone();
  v.applyEuler(meshGroup.rotation);
  v.project(camera);
  const rect = stage.getBoundingClientRect();
  return {
    x: ( v.x * 0.5 + 0.5) * rect.width,
    y: (-v.y * 0.5 + 0.5) * rect.height,
    z:   v.z,
  };
}

// ── Render loop ───────────────────────────────────────────────────────────────
function animate() {
  requestAnimationFrame(animate);

  meshMeta.forEach(({ titleEl, titleAnchor }) => {
    if (!titleEl) return;
    const s = toScreen(titleAnchor);
    // Hide labels that are behind camera (z > 1) or too far to the side
    if (s.z > 1) {
      titleEl.style.opacity = '0';
      return;
    }
    titleEl.style.left = s.x + 'px';
    titleEl.style.top  = s.y + 'px';
  });

  renderer.render(scene, camera);
}

// ── Init ──────────────────────────────────────────────────────────────────────
syncSize();
applyGroupRotation();
animate();

window.addEventListener('resize', syncSize, { passive: true });
</script>

