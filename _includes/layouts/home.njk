<script type="module">
// NOTE: importing three.js directly from its full esm.sh URL instead of via
// an <script type="importmap"> "three" bare specifier. Import maps must be
// registered before *any* module load/preload has started, and Firefox and
// Safari enforce that strictly — on this page the importmap block was losing
// that race (likely due to the async GTM <script> executing first), which
// left "three" unresolved ("bare specifier ... was not remapped to
// anything"). Importing the full URL removes the race entirely and works
// identically across Chrome/Firefox/Safari.
import {
  Scene, PerspectiveCamera, WebGLRenderer,
  TubeGeometry, CatmullRomCurve3, CircleGeometry,
  MeshStandardMaterial, MeshBasicMaterial,
  Mesh, PlaneGeometry, DoubleSide,
  LineSegments, BufferGeometry, Float32BufferAttribute,
  LineBasicMaterial,
  AmbientLight, DirectionalLight, PointLight,
  TextureLoader, CanvasTexture,
  Color, Raycaster, Vector2, Vector3, Quaternion,
  Group
} from 'https://esm.sh/three@0.169.0';

// ── Guard ────────────────────────────────────────────────────────────────────
const stage      = document.querySelector('[data-axis-stage]');
const canvas     = document.querySelector('[data-axis-canvas]');
const projectEls = Array.from(document.querySelectorAll('[data-axis-project]'));
const headlineEl = document.querySelector('[data-chart-headline]');
const headlineH1 = headlineEl ? headlineEl.querySelector('h1') : null;
const bgStrip    = document.querySelector('[data-chart-bg]');
const avatarEl   = document.querySelector('[data-avatar-src]');
if (!stage || !canvas || !projectEls.length) throw new Error('[axis] missing DOM');

// ── Default headline text ────────────────────────────────────────────────────
const DEFAULT_HEADLINE = headlineH1 ? headlineH1.textContent : '';

// ── Renderer ─────────────────────────────────────────────────────────────────
const renderer = new WebGLRenderer({ canvas, antialias: true, alpha: true });
renderer.setClearColor(0x000000, 0);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

function syncSize() {
  const w = stage.clientWidth;
  const h = stage.clientHeight;
  renderer.setSize(w, h, false);
  camera.aspect = w / h;
  camera.updateProjectionMatrix();
  logCameraPosition('resize');
}

// ── Scene + Camera ───────────────────────────────────────────────────────────
const scene  = new Scene();
const camera = new PerspectiveCamera(58, 1, 0.1, 2000);
// Overhead-left view — camera high + left, looking down-right at chart center
// Matches reference: steep overhead, clock face nearly horizontal, shifted left
// DEFAULT_CAMERA_POSITION — edit this to change the chart's starting viewpoint.
// Logged to console on every camera update below so new defaults can be read off directly.
const DEFAULT_CAMERA_POSITION = { x: -120, y: 320, z: 340 };
camera.position.set(DEFAULT_CAMERA_POSITION.x, DEFAULT_CAMERA_POSITION.y, DEFAULT_CAMERA_POSITION.z);
camera.lookAt(0, 0, 0);

// Print camera position to console whenever it changes (drag rotation, resize, etc.)
// so the current view can be captured and pasted back in as the new default.
// Drag rotation actually spins `meshGroup` (rotX/rotY below), not the camera itself —
// so on every user-driven change we log both the (static) camera xyz AND the live
// rotX/rotY, since those together are what you dial in to define the "default" view.
function logCameraPosition(reason) {
  const { x, y, z } = camera.position;
  // rotX/rotY are declared later (drag rotation state) — guard with a try/catch
  // rather than `typeof`, since `typeof` on a not-yet-initialized `let` throws
  // (temporal dead zone) instead of returning 'undefined'.
  let rotation;
  try {
    rotation = { rotX: +rotX.toFixed(1), rotY: +rotY.toFixed(1) };
  } catch (e) {
    rotation = undefined;
  }
  console.log(
    `[axis-chart] camera.position (${reason}):`,
    { x: +x.toFixed(1), y: +y.toFixed(1), z: +z.toFixed(1) },
    rotation
  );
}
logCameraPosition('init');

// ── Lights ───────────────────────────────────────────────────────────────────
scene.add(new AmbientLight(0xffffff, 0.85));
const sun = new DirectionalLight(0xd0eeff, 0.9);
sun.position.set(1.2, 2, 1.5);
scene.add(sun);
const fill = new PointLight(0x7287fd, 0.6, 1800);
fill.position.set(-220, 140, 340);
scene.add(fill);

// ── Headline billboard — real mesh in the 3D scene, SAME billboard plane as avatar ──
// Previously a CSS overlay pinned at z-index:0 (always BEHIND the canvas, tubes could
// only ever pass in front of it, never behind). Moving it into the scene next to the
// avatar mesh — same technique, same depth defaults — lets the WebGL depth buffer sort
// tube arcs in front of AND behind the headline text, exactly like the avatar.
const HEADLINE_CANVAS_W = 1400;
const HEADLINE_CANVAS_H = 460;
const headlineCanvas = document.createElement('canvas');
headlineCanvas.width  = HEADLINE_CANVAS_W;
headlineCanvas.height = HEADLINE_CANVAS_H;
const hctx = headlineCanvas.getContext('2d');

// Colors/weights mirror the reference headline CSS on main (.homepage-headline-axis):
// font-weight 800 variable, letter-spacing -0.02em, uppercase, color-mix(text-color 88%, anp-base)
function drawHeadlineText(text, dimmed) {
  hctx.clearRect(0, 0, HEADLINE_CANVAS_W, HEADLINE_CANVAS_H);
  hctx.textAlign = 'left';
  hctx.textBaseline = 'alphabetic';
  hctx.fillStyle = dimmed ? 'rgba(40,37,31,0.60)' : 'rgba(40,37,31,0.90)';
  const fontSize   = 92;
  const lineHeight = fontSize * 0.95; // matches line-height: 0.95 on the reference
  hctx.font = `800 ${fontSize}px 'Google Sans Flex', 'Outfit', system-ui, sans-serif`;

  // Manual word-wrap (canvas has no text-wrap: balance)
  const maxWidth = HEADLINE_CANVAS_W - 20;
  const words = (text || '').toUpperCase().split(' ');
  const lines = [];
  let line = '';
  words.forEach(word => {
    const test = line ? `${line} ${word}` : word;
    if (line && hctx.measureText(test).width > maxWidth) {
      lines.push(line);
      line = word;
    } else {
      line = test;
    }
  });
  if (line) lines.push(line);

  let y = fontSize;
  lines.forEach(l => { hctx.fillText(l, 0, y); y += lineHeight; });

  if (headlineTex) headlineTex.needsUpdate = true;
}

let headlineTex   = null;
let headlinePlane = null;
if (headlineH1) {
  headlineTex = new CanvasTexture(headlineCanvas);
  drawHeadlineText(DEFAULT_HEADLINE, false);
  const HEADLINE_PLANE_W = 360;
  const HEADLINE_PLANE_H = HEADLINE_PLANE_W * (HEADLINE_CANVAS_H / HEADLINE_CANVAS_W);
  headlinePlane = new Mesh(
    new PlaneGeometry(HEADLINE_PLANE_W, HEADLINE_PLANE_H),
    new MeshBasicMaterial({ map: headlineTex, transparent: true, side: DoubleSide })
    // depthWrite/depthTest left at their defaults (true) — same as avatarMesh —
    // so tube geometry sorts naturally in front of and behind this plane too.
  );
  // Offset from the avatar (both at the scene origin depth) so the two billboards
  // sit side-by-side on the same plane rather than overlapping exactly.
  headlinePlane.position.set(-230, 90, 0);
  scene.add(headlinePlane);
  // Hide the DOM/CSS version — it's now only a text data source for drawHeadlineText.
  headlineEl.style.display = 'none';
}

// ── Avatar billboard — real mesh in the 3D scene ─────────────────────────────
// Previously a CSS overlay pinned above everything (avatar > tubes > headline
// always). Moving it into the scene at the origin lets the WebGL depth buffer
// sort it against tube geometry naturally: tubes nearer the camera than the
// avatar plane occlude it, tubes farther away are occluded by it — a real
// middle plane, not a fixed z-index split.
let avatarMesh = null;
if (avatarEl && avatarEl.dataset.avatarSrc) {
  const AVATAR_SIZE = 130; // world units, roughly matches old 120px CSS circle
  avatarMesh = new Mesh(
    new PlaneGeometry(AVATAR_SIZE, AVATAR_SIZE),
    new MeshBasicMaterial({ transparent: true, opacity: 0, side: DoubleSide })
    // depthWrite/depthTest left at their defaults (true) so tubes in front of
    // the avatar occlude it and tubes behind it get occluded — real 3D sort.
  );
  avatarMesh.position.set(0, 0, 0);
  scene.add(avatarMesh);

  new TextureLoader().load(avatarEl.dataset.avatarSrc, (tex) => {
    avatarMesh.material.map = tex;
    avatarMesh.material.opacity = 0.96;
    avatarMesh.material.needsUpdate = true;
  });
}

// ── Radial chart constants ────────────────────────────────────────────────────
const CAREER_START_YEAR  = 2010;
const CAREER_START_MONTH = 1;
const CAREER_END_YEAR    = 2026;
const CAREER_END_MONTH   = 8;
const CAREER_MONTHS      = (CAREER_END_YEAR - CAREER_START_YEAR) * 12
                           + (CAREER_END_MONTH - CAREER_START_MONTH); // 199

const RADIANS_PER_MONTH = (2 * Math.PI) / CAREER_MONTHS;
const THETA_6OCLOCK     = -Math.PI / 2;   // bottom of clock (−Y axis)

const R_INNER  = 100;   // solo projects radius
const R_OUTER  = 280;   // team projects radius
const Y_RANGE  = 200;   // ± elevation (medium axis depth)
const TUBE_R   = 20;    // tube cross-section radius
const ARC_SEGS = 72;    // arc curve resolution

// ── Per-project dominant colors — extracted from actual project images ────────
// Each key is the project slug (from data-chart-blend path: /img/chart-blend/<slug>.webp)
const PROJECT_COLORS = {
  'amazon-fire-os':              0xd97e0c,
  'android-gemini':              0x9a673d,
  'awake-chocolate':             0x724026,
  'bakedin':                     0x40ade1,
  'bathroom-brad':               0xf96148,
  'decibel-festival':            0x24a979,
  'early-work':                  0x8ba1a9,
  'google-meet':                 0x009899,
  'job-intelligence-scraper':    0x2f364d,
  'lumedic':                     0x02c4a4,
  'lyfe':                        0xd4deea,
  'metastream':                  0xe0795e,
  'microsoft-learning-platform': 0x24c28e,
  'photogrammetry':              0xb5946d,
  'pixels-of-fury':              0x1eda95,
  'posters':                     0xb86942,
  'priority-card-maker':         0x007136,
  'priority-tax-relief':         0xbd5623,
  'providence':                  0x6088aa,
  'pwc':                         0x263b74,
  'resonance-ai':                0x44b879,
  'seattle-creative-directory':  0xd8e85a,
  'short-shorts-and-lawn-sports':0x839859,
  'studio-tours':                0xf75959,
  'teaching':                    0xd18235,
  'vine-wars':                   0x08c375,
  'xbox-one-smartglass':         0x007ec1,
  'yakitate':                    0xb17207,
};

// ── Dots texture — rough field of tiny dots, no gloss ────────────────────────
function makeDotsTexture(size = 256) {
  const c = document.createElement('canvas');
  c.width = c.height = size;
  const ctx = c.getContext('2d');
  ctx.fillStyle = '#c8cdd8';
  ctx.fillRect(0, 0, size, size);
  const dotRadius = 1.1;
  const spacing   = 7;
  ctx.fillStyle = 'rgba(80,88,108,0.55)';
  for (let y = spacing / 2; y < size; y += spacing) {
    for (let x = spacing / 2; x < size; x += spacing) {
      ctx.beginPath();
      ctx.arc(x + (Math.random() - 0.5) * 1.5, y + (Math.random() - 0.5) * 1.5, dotRadius, 0, Math.PI * 2);
      ctx.fill();
    }
  }
  return new CanvasTexture(c);
}

const dotsTex = makeDotsTexture(256);

// ── Helper: months since career start ────────────────────────────────────────
function monthsElapsed(dateStr) {
  if (!dateStr) return 0;
  const [y, m] = dateStr.split('-').map(Number);
  return Math.max(0, (y - CAREER_START_YEAR) * 12 + (m - CAREER_START_MONTH));
}

// ── Helper: point on circle at radius r, elevation y, angle theta ─────────
function circlePoint(r, yElev, theta) {
  return new Vector3(r * Math.cos(theta), yElev, r * Math.sin(theta));
}

// ── Helper: build arc curve ───────────────────────────────────────────────
function makeArcCurve(r, yElev, thetaStart, thetaEnd) {
  const pts = [];
  for (let i = 0; i <= ARC_SEGS; i++) {
    const t   = i / ARC_SEGS;
    const ang = thetaStart + t * (thetaEnd - thetaStart);
    pts.push(circlePoint(r, yElev, ang));
  }
  return new CatmullRomCurve3(pts, false, 'catmullrom', 0.0);
}

// ── Axis reference rings ──────────────────────────────────────────────────────
function makeRingVerts(r, segments = 128) {
  const verts = [];
  for (let i = 0; i <= segments; i++) {
    const a  = (i / segments) * 2 * Math.PI;
    const a2 = ((i + 1) / segments) * 2 * Math.PI;
    verts.push(r * Math.cos(a), 0, r * Math.sin(a));
    verts.push(r * Math.cos(a2), 0, r * Math.sin(a2));
  }
  return new Float32Array(verts);
}

const ringMat = new LineBasicMaterial({ color: 0x7287fd, transparent: true, opacity: 0.12 });
for (const r of [R_INNER, (R_INNER + R_OUTER) / 2, R_OUTER]) {
  const rg = new BufferGeometry();
  rg.setAttribute('position', new Float32BufferAttribute(makeRingVerts(r), 3));
  scene.add(new LineSegments(rg, ringMat.clone()));
}

// Career-start tick line
const tickVerts = new Float32Array([0, 0, -R_OUTER * 1.05, 0, 0,  R_OUTER * 1.05]);
const tickGeo   = new BufferGeometry();
tickGeo.setAttribute('position', new Float32BufferAttribute(tickVerts, 3));
scene.add(new LineSegments(tickGeo, new LineBasicMaterial({ color: 0x9ca0b0, transparent: true, opacity: 0.15 })));

// ── Build project arc tubes ───────────────────────────────────────────────────
const meshGroup = new Group();
scene.add(meshGroup);

const loader   = new TextureLoader();
const meshMeta = [];

projectEls.forEach((el) => {
  const dateStr  = el.dataset.chartDate  || '';
  const duration = parseInt(el.dataset.chartDuration      || '6',  10);
  const collab   = parseInt(el.dataset.chartCollaboration || '50', 10) / 100;
  const medium   = parseInt(el.dataset.chartMedium        || '50', 10) / 100;
  const url      = el.dataset.projectUrl   || '#';
  const title    = el.dataset.projectTitle || '';
  const blendSrc = el.dataset.chartBlend   || null;

  // Collect all per-project image URLs for background strip
  let scrubImages = [];
  try { scrubImages = JSON.parse(el.dataset.chartImages || '[]'); } catch(e) {}

  // ── Radial position ──────────────────────────────────────────────────────
  const r      = R_INNER + collab * (R_OUTER - R_INNER);
  const yElev  = (medium - 0.5) * 2 * Y_RANGE;
  const elapsed    = monthsElapsed(dateStr);
  const thetaStart = THETA_6OCLOCK - elapsed     * RADIANS_PER_MONTH;
  const thetaEnd   = thetaStart    - duration    * RADIANS_PER_MONTH;
  const thetaMid   = (thetaStart + thetaEnd) / 2;

  // ── Tube material — per-project dominant color, rough texture ───────────────
  // Derive slug from blend path: /img/chart-blend/<slug>.webp
  const slug = blendSrc ? blendSrc.replace(/^.*\//, '').replace(/\.webp$/, '') : '';
  const projectColor = PROJECT_COLORS[slug] || 0xd8dce8;

  // Start with dots texture + per-project color; blend image loads on top if available
  const mat = new MeshStandardMaterial({
    map: dotsTex,
    color: projectColor,
    roughness: 0.95,
    metalness: 0.0,
    transparent: true,
    opacity: 0.92,
  });

  // Load blend image — tints on top of per-project dominant color
  if (blendSrc) {
    loader.load(blendSrc, (tex) => {
      mat.map   = tex;
      mat.color.set(projectColor);  // keep per-project tint when blend loads
      mat.roughness  = 0.88;
      mat.opacity    = 0.92;
      mat.needsUpdate = true;
      // capMat is cloned after mat, so sync it here too once caps are created
      // (capMat is available in closure via the per-project scope)
      if (typeof capMat !== 'undefined') {
        capMat.map = tex;
        capMat.color.set(projectColor);
        capMat.roughness  = 0.88;
        capMat.opacity    = 0.92;
        capMat.needsUpdate = true;
      }
    });
  }

  // ── Arc tube — smooth round TubeGeometry ─────────────────────────────────
  const arcSegs = Math.max(16, Math.round(ARC_SEGS * (duration / CAREER_MONTHS)));
  const curve   = makeArcCurve(r, yElev, thetaStart, thetaEnd);
  const tube    = new Mesh(
    new TubeGeometry(curve, arcSegs, TUBE_R, 20, false),
    mat
  );
  tube.userData = { url, title };
  meshGroup.add(tube);

  // ── Flat disc endcaps — CircleGeometry sealed to each open end ───────────
  // TubeGeometry(closed=false) leaves open circular holes. Seal them with
  // flat CircleGeometry discs aligned to the tube's tangent at each endpoint.
  // Uses quaternion.setFromUnitVectors to rotate the disc normal onto the tangent.
  const capMat = mat.clone();
  capMat.side = 2; // DoubleSide value — visible from both directions
  const capGeo = new CircleGeometry(TUBE_R, 20);

  // Start cap — tangent points back along the curve (invert)
  const tanStart = curve.getTangentAt(0).negate();
  const capS = new Mesh(capGeo, capMat);
  capS.position.copy(circlePoint(r, yElev, thetaStart));
  capS.quaternion.setFromUnitVectors(new Vector3(0, 0, 1), tanStart.normalize());
  meshGroup.add(capS);

  // End cap — tangent points forward
  const tanEnd = curve.getTangentAt(1);
  const capE = new Mesh(capGeo, capMat);
  capE.position.copy(circlePoint(r, yElev, thetaEnd));
  capE.quaternion.setFromUnitVectors(new Vector3(0, 0, 1), tanEnd.normalize());
  meshGroup.add(capE);

  // Anchor for screen-space tooltip (midpoint above tube)
  const midPt = circlePoint(r, yElev + TUBE_R + 4, thetaMid);
  meshMeta.push({ tube, capS, capE, midPt, url, title, scrubImages, mat, capMat, loader });
});

// ── Drag rotation ────────────────────────────────────────────────────────────
let isDragging = false, startX = 0, startY = 0;
let rotX = -5.1, rotY = 38.6;  // dialed-in default view (2026-08-27), read from console during drag

function applyGroupRotation() {
  const rx = rotX * Math.PI / 180;
  const ry = rotY * Math.PI / 180;
  meshGroup.rotation.set(rx, ry, 0);
  // Also rotate rings and tick lines
  scene.children.forEach(c => {
    if (c instanceof LineSegments) c.rotation.set(rx, ry, 0);
  });
}

stage.addEventListener('mousedown',  e => { isDragging = true; startX = e.clientX; startY = e.clientY; stage.style.cursor = 'grabbing'; });
window.addEventListener('mouseup',   () => {
  const wasDragging = isDragging;
  isDragging = false;
  stage.style.cursor = 'grab';
  if (wasDragging) logCameraPosition('drag-end');  // ← console update on user change, for dialing in defaults
});
window.addEventListener('mousemove', e => {
  if (!isDragging) return;
  rotY += (e.clientX - startX) * 0.35;
  rotX -= (e.clientY - startY) * 0.35;
  startX = e.clientX; startY = e.clientY;
  applyGroupRotation();
});

stage.addEventListener('touchstart', e => {
  isDragging = true;
  startX = e.touches[0].clientX; startY = e.touches[0].clientY;
}, { passive: true });
window.addEventListener('touchend', () => {
  const wasDragging = isDragging;
  isDragging = false;
  if (wasDragging) logCameraPosition('drag-end');  // ← console update on user change, for dialing in defaults
});
stage.addEventListener('touchmove', e => {
  if (!isDragging) return;
  e.preventDefault();
  rotY += (e.touches[0].clientX - startX) * 0.35;
  rotX -= (e.touches[0].clientY - startY) * 0.35;
  startX = e.touches[0].clientX; startY = e.touches[0].clientY;
  applyGroupRotation();
}, { passive: false });

// ── Hover: raycaster + headline update + background strip ─────────────────────
const raycaster  = new Raycaster();
const pointerVec = new Vector2();
let hoveredTube  = null;

// Map tube + cap meshes → metadata (so raycaster hits on caps resolve correctly)
const meshToMeta = new Map();
meshMeta.forEach(m => {
  meshToMeta.set(m.tube, m);
  meshToMeta.set(m.capS, m);
  meshToMeta.set(m.capE, m);
});

// Update the headline canvas texture and background strip on hover
function setHoverState(meta) {
  if (headlinePlane && meta) {
    drawHeadlineText(meta.title, true);
  }
  if (bgStrip && meta && meta.scrubImages && meta.scrubImages.length) {
    // Build a horizontal strip of stacked images (screenshot 3 style)
    const imgs = meta.scrubImages.slice(0, 8);
    bgStrip.innerHTML = imgs.map(src =>
      `<img src="${src}" alt="" aria-hidden="true" class="home-axis-bg-img">`
    ).join('');
    bgStrip.style.opacity = '1';
    bgStrip.setAttribute('data-active', meta.title);
  }
}

function clearHoverState() {
  if (headlinePlane) {
    drawHeadlineText(DEFAULT_HEADLINE, false);
  }
  if (bgStrip) {
    bgStrip.style.opacity = '0';
    bgStrip.removeAttribute('data-active');
  }
}

stage.addEventListener('mousemove', e => {
  const rect = stage.getBoundingClientRect();
  const mx   = e.clientX - rect.left;
  const my   = e.clientY - rect.top;
  pointerVec.x =  (mx / rect.width)  * 2 - 1;
  pointerVec.y = -((my / rect.height)) * 2 + 1;
  raycaster.setFromCamera(pointerVec, camera);

  const allMeshes = [...meshToMeta.keys()];
  const hits = raycaster.intersectObjects(allMeshes);

  if (hits.length) {
    const meta = meshToMeta.get(hits[0].object);
    if (!meta) return;

    // Emissive highlight — tube + caps
    if (hoveredTube !== meta.tube) {
      if (hoveredTube) {
        const prev = meshToMeta.get(hoveredTube);
        if (prev) {
          prev.mat.emissiveIntensity = 0;
          prev.capMat.emissiveIntensity = 0;
        }
      }
      hoveredTube = meta.tube;
      meta.mat.emissive    = new Color(0x04a5e5);
      meta.capMat.emissive = new Color(0x04a5e5);
      meta.mat.emissiveIntensity    = 0.28;
      meta.capMat.emissiveIntensity = 0.28;
      setHoverState(meta);
    }

    if (!isDragging) stage.style.cursor = 'pointer';
  } else {
    if (hoveredTube) {
      const prev = meshToMeta.get(hoveredTube);
      if (prev) {
        prev.mat.emissiveIntensity = 0;
        prev.capMat.emissiveIntensity = 0;
      }
      hoveredTube = null;
      clearHoverState();
    }
    if (!isDragging) stage.style.cursor = 'grab';
  }
});

stage.addEventListener('mouseleave', () => {
  if (hoveredTube) {
    const prev = meshToMeta.get(hoveredTube);
    if (prev) {
      prev.mat.emissiveIntensity = 0;
      prev.capMat.emissiveIntensity = 0;
    }
    hoveredTube = null;
  }
  clearHoverState();
});

stage.addEventListener('click', () => {
  if (hoveredTube) window.location.href = meshToMeta.get(hoveredTube)?.url || '#';
});

// ── Render loop ───────────────────────────────────────────────────────────────
function animate() {
  requestAnimationFrame(animate);
  // Billboard: avatar + headline always face the camera's view plane, regardless of
  // meshGroup rotation from dragging — copy the camera's world quaternion. Same
  // billboard plane for both, so tubes sort in front of/behind either one identically.
  if (avatarMesh)   avatarMesh.quaternion.copy(camera.quaternion);
  if (headlinePlane) headlinePlane.quaternion.copy(camera.quaternion);
  renderer.render(scene, camera);
}

// ── Init ──────────────────────────────────────────────────────────────────────
syncSize();
applyGroupRotation();
animate();

window.addEventListener('resize', syncSize, { passive: true });
</script>

