<script type="importmap">
{
  "imports": {
    "three": "https://esm.sh/three@0.169.0"
  }
}
</script>

<script type="module">
import {
  Scene, PerspectiveCamera, WebGLRenderer,
  TubeGeometry, CatmullRomCurve3,
  SphereGeometry, PlaneGeometry,
  MeshStandardMaterial, MeshBasicMaterial,
  Mesh,
  LineSegments, BufferGeometry, Float32BufferAttribute,
  LineBasicMaterial,
  AmbientLight, DirectionalLight, PointLight,
  TextureLoader, CanvasTexture,
  Color, Raycaster, Vector2, Vector3,
  Group, DoubleSide
} from 'three';

// ── Guard ────────────────────────────────────────────────────────────────────
const stage      = document.querySelector('[data-axis-stage]');
const canvas     = document.querySelector('[data-axis-canvas]');
const projectEls = Array.from(document.querySelectorAll('[data-axis-project]'));
if (!stage || !canvas || !projectEls.length) throw new Error('[axis] missing DOM');

// ── Renderer ─────────────────────────────────────────────────────────────────
const renderer = new WebGLRenderer({ canvas, antialias: true, alpha: true });
renderer.setClearColor(0x000000, 0);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

function syncSize() {
  const w = stage.clientWidth;
  const h = stage.clientHeight;
  renderer.setSize(w, h, false);
  camera.aspect = w / h;
  camera.updateProjectionMatrix();
}

// ── Scene + Camera ───────────────────────────────────────────────────────────
const scene  = new Scene();
const camera = new PerspectiveCamera(52, 1, 0.1, 2000);
// ¾ above the tubes — looking steeply down at ~55° angle
camera.position.set(0, 380, 260);
camera.lookAt(0, 0, 0);

// ── Lights ───────────────────────────────────────────────────────────────────
scene.add(new AmbientLight(0xffffff, 0.65));
const sun = new DirectionalLight(0xd0eeff, 1.2);
sun.position.set(1.2, 2, 1.5);
scene.add(sun);
const fill = new PointLight(0x04a5e5, 1.0, 1800);
fill.position.set(-220, 140, 340);
scene.add(fill);

// ── Radial chart constants ────────────────────────────────────────────────────
const CAREER_START_YEAR  = 2010;
const CAREER_START_MONTH = 1;
const CAREER_END_YEAR    = 2026;
const CAREER_END_MONTH   = 8;
const CAREER_MONTHS      = (CAREER_END_YEAR - CAREER_START_YEAR) * 12
                           + (CAREER_END_MONTH - CAREER_START_MONTH); // 199

const RADIANS_PER_MONTH = (2 * Math.PI) / CAREER_MONTHS;
const THETA_6OCLOCK     = -Math.PI / 2;   // bottom of clock (−Y axis)

const R_INNER  = 70;    // solo projects radius
const R_OUTER  = 200;   // team projects radius
const Y_RANGE  = 180;   // ± elevation (medium axis depth)
const TUBE_R   = 16;    // tube cross-section radius
const ARC_SEGS = 72;    // arc curve resolution

const SKY = new Color(0x04a5e5);

// ── Helper: months since career start ────────────────────────────────────────
function monthsElapsed(dateStr) {
  if (!dateStr) return 0;
  const [y, m] = dateStr.split('-').map(Number);
  return Math.max(0, (y - CAREER_START_YEAR) * 12 + (m - CAREER_START_MONTH));
}

// ── Helper: point on circle at radius r, elevation y, angle theta ─────────
function circlePoint(r, yElev, theta) {
  return new Vector3(r * Math.cos(theta), yElev, r * Math.sin(theta));
}

// ── Helper: build arc curve ───────────────────────────────────────────────
function makeArcCurve(r, yElev, thetaStart, thetaEnd) {
  const pts = [];
  for (let i = 0; i <= ARC_SEGS; i++) {
    const t   = i / ARC_SEGS;
    const ang = thetaStart + t * (thetaEnd - thetaStart);
    pts.push(circlePoint(r, yElev, ang));
  }
  return new CatmullRomCurve3(pts, false, 'catmullrom', 0.0);
}

// ── Axis reference rings ──────────────────────────────────────────────────────
function makeRingVerts(r, segments = 128) {
  const verts = [];
  for (let i = 0; i <= segments; i++) {
    const a  = (i / segments) * 2 * Math.PI;
    const a2 = ((i + 1) / segments) * 2 * Math.PI;
    verts.push(r * Math.cos(a), 0, r * Math.sin(a));
    verts.push(r * Math.cos(a2), 0, r * Math.sin(a2));
  }
  return new Float32Array(verts);
}

const ringMat = new LineBasicMaterial({ color: 0x7287fd, transparent: true, opacity: 0.12 });
for (const r of [R_INNER, (R_INNER + R_OUTER) / 2, R_OUTER]) {
  const rg = new BufferGeometry();
  rg.setAttribute('position', new Float32BufferAttribute(makeRingVerts(r), 3));
  scene.add(new LineSegments(rg, ringMat.clone()));
}

// Career-start tick line
const tickVerts = new Float32Array([0, 0, -R_OUTER * 1.05, 0, 0,  R_OUTER * 1.05]);
const tickGeo   = new BufferGeometry();
tickGeo.setAttribute('position', new Float32BufferAttribute(tickVerts, 3));
scene.add(new LineSegments(tickGeo, new LineBasicMaterial({ color: 0x9ca0b0, transparent: true, opacity: 0.15 })));

// ── Headline plane — flat in scene, tubes pass in front and behind ────────────
// Rendered on a canvas texture so it's pure 3D geometry, not a DOM overlay.
const headlineCanvas = document.createElement('canvas');
headlineCanvas.width  = 1200;
headlineCanvas.height = 220;
const hctx = headlineCanvas.getContext('2d');
hctx.clearRect(0, 0, 1200, 220);
// Headline text
hctx.font         = 'bold 68px system-ui, -apple-system, sans-serif';
hctx.textAlign    = 'center';
hctx.textBaseline = 'middle';
hctx.fillStyle    = 'rgba(255,255,255,0.88)';
hctx.letterSpacing = '0.05em';
hctx.fillText('HUMAN CENTERED DESIGN WORK', 600, 78);
hctx.fillText('FROM JONNY MCCONNELL', 600, 154);

const headlineTex  = new CanvasTexture(headlineCanvas);
const headlinePlane = new Mesh(
  new PlaneGeometry(360, 66),
  new MeshBasicMaterial({ map: headlineTex, transparent: true, opacity: 0.90, depthWrite: false, side: DoubleSide })
);
// Position the headline in the XZ plane — some tubes will be in front, some behind
headlinePlane.rotation.x = -Math.PI / 2;   // flat, facing up (camera looks down)
headlinePlane.position.set(0, 2, 0);        // just above y=0 plane so it doesn't z-fight rings
scene.add(headlinePlane);

// ── Portrait billboard at origin ──────────────────────────────────────────────
// Stays flat and always faces the camera via onBeforeRender quaternion copy.
const loader   = new TextureLoader();
const portraitMesh = new Mesh(
  new PlaneGeometry(55, 55),
  new MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0, side: DoubleSide, depthWrite: false })
);
portraitMesh.position.set(0, 0, 0);
scene.add(portraitMesh);

loader.load('https://github.com/user-attachments/assets/c956ad3d-f0ab-4737-a3c6-e3bd8ff7038b', (tex) => {
  portraitMesh.material.map     = tex;
  portraitMesh.material.opacity = 0.92;
  portraitMesh.material.needsUpdate = true;
});

// ── Build project arc tubes ───────────────────────────────────────────────────
const meshGroup = new Group();
scene.add(meshGroup);

// Tooltip DOM overlay
const tooltip = document.createElement('div');
tooltip.style.cssText = [
  'position:absolute', 'pointer-events:none', 'z-index:10',
  'padding:5px 10px', 'border-radius:6px',
  'background:rgba(15,23,42,0.82)', 'backdrop-filter:blur(8px)',
  'color:#fff', 'font:600 13px/1.3 system-ui,sans-serif',
  'letter-spacing:0.02em', 'white-space:nowrap',
  'opacity:0', 'transition:opacity 0.15s',
  'transform:translate(-50%,-110%)',
].join(';');
stage.appendChild(tooltip);

const meshMeta = [];

projectEls.forEach((el) => {
  const dateStr  = el.dataset.chartDate  || '';
  const duration = parseInt(el.dataset.chartDuration      || '6',  10);
  const collab   = parseInt(el.dataset.chartCollaboration || '50', 10) / 100;
  const medium   = parseInt(el.dataset.chartMedium        || '50', 10) / 100;
  const url      = el.dataset.projectUrl   || '#';
  const title    = el.dataset.projectTitle || '';
  const blendSrc = el.dataset.chartBlend   || null;

  // Collect all per-project image URLs for hover scrub
  // emitted as JSON in data-chart-images by Nunjucks
  let scrubImages = [];
  try { scrubImages = JSON.parse(el.dataset.chartImages || '[]'); } catch(e) {}

  // ── Radial position ──────────────────────────────────────────────────────
  const r      = R_INNER + collab * (R_OUTER - R_INNER);
  const yElev  = (medium - 0.5) * 2 * Y_RANGE;
  const elapsed    = monthsElapsed(dateStr);
  const thetaStart = THETA_6OCLOCK - elapsed     * RADIANS_PER_MONTH;
  const thetaEnd   = thetaStart    - duration    * RADIANS_PER_MONTH;
  const thetaMid   = (thetaStart + thetaEnd) / 2;

  // ── Shared material ──────────────────────────────────────────────────────
  const mat = new MeshStandardMaterial({
    color: SKY.clone(), roughness: 0.42, metalness: 0.10,
    transparent: true, opacity: 0.86,
  });

  const imgSrc = blendSrc;
  let texObj = null;
  if (imgSrc) {
    loader.load(imgSrc, (tex) => {
      texObj = tex;
      mat.map       = tex;
      mat.color.set(0xffffff);
      mat.roughness  = 0.50;
      mat.opacity    = 0.90;
      mat.needsUpdate = true;
    });
  }

  // ── Arc tube ──────────────────────────────────────────────────────────────
  const arcSegs = Math.max(16, Math.round(ARC_SEGS * (duration / CAREER_MONTHS)));
  const curve   = makeArcCurve(r, yElev, thetaStart, thetaEnd);
  const tube    = new Mesh(new TubeGeometry(curve, arcSegs, TUBE_R, 20, false), mat);
  tube.userData = { url, title, scrubImages, texObj: null };
  meshGroup.add(tube);

  // ── Spherical endcaps — same material, shared ref ────────────────────────
  const capMat = mat.clone();
  const capGeo = new SphereGeometry(TUBE_R, 20, 16);

  const capStart = new Mesh(capGeo, capMat);
  capStart.position.copy(circlePoint(r, yElev, thetaStart));
  meshGroup.add(capStart);

  const capEnd = new Mesh(capGeo, capMat);
  capEnd.position.copy(circlePoint(r, yElev, thetaEnd));
  meshGroup.add(capEnd);

  // Keep caps in sync when texture loads
  if (imgSrc) {
    loader.load(imgSrc, (tex) => {
      [capMat].forEach(m => {
        m.map = tex; m.color.set(0xffffff);
        m.roughness = 0.50; m.opacity = 0.90; m.needsUpdate = true;
      });
    });
  }

  // Anchor for screen-space tooltip
  const midPt = circlePoint(r, yElev + TUBE_R + 4, thetaMid);
  meshMeta.push({ tube, capStart, capEnd, midPt, url, title, scrubImages, mat, capMat, loader });
});

// ── Drag rotation ────────────────────────────────────────────────────────────
let isDragging = false, startX = 0, startY = 0;
let rotX = -52, rotY = 0;  // ¾ above: match steep camera with group tilt

function applyGroupRotation() {
  const rx = rotX * Math.PI / 180;
  const ry = rotY * Math.PI / 180;
  meshGroup.rotation.set(rx, ry, 0);
  // Also rotate rings and tick lines
  scene.children.forEach(c => {
    if (c instanceof LineSegments) c.rotation.set(rx, ry, 0);
  });
  headlinePlane.rotation.set(-Math.PI / 2 + rx, ry, 0);
}

stage.addEventListener('mousedown',  e => { isDragging = true; startX = e.clientX; startY = e.clientY; stage.style.cursor = 'grabbing'; });
window.addEventListener('mouseup',   () => { isDragging = false; stage.style.cursor = 'grab'; });
window.addEventListener('mousemove', e => {
  if (!isDragging) return;
  rotY += (e.clientX - startX) * 0.35;
  rotX -= (e.clientY - startY) * 0.35;
  startX = e.clientX; startY = e.clientY;
  applyGroupRotation();
});

stage.addEventListener('touchstart', e => {
  isDragging = true;
  startX = e.touches[0].clientX; startY = e.touches[0].clientY;
}, { passive: true });
window.addEventListener('touchend', () => { isDragging = false; });
stage.addEventListener('touchmove', e => {
  if (!isDragging) return;
  e.preventDefault();
  rotY += (e.touches[0].clientX - startX) * 0.35;
  rotX -= (e.touches[0].clientY - startY) * 0.35;
  startX = e.touches[0].clientX; startY = e.touches[0].clientY;
  applyGroupRotation();
}, { passive: false });

// ── Hover: raycaster + tooltip + image scrub ──────────────────────────────────
const raycaster  = new Raycaster();
const pointerVec = new Vector2();
let hoveredTube  = null;
let scrubTimeout = null;

// Map all tube+cap meshes → their parent metadata record
const meshToMeta = new Map();
meshMeta.forEach(m => {
  meshToMeta.set(m.tube, m);
  meshToMeta.set(m.capStart, m);
  meshToMeta.set(m.capEnd, m);
});

stage.addEventListener('mousemove', e => {
  const rect = stage.getBoundingClientRect();
  const mx   = e.clientX - rect.left;
  const my   = e.clientY - rect.top;
  pointerVec.x =  (mx / rect.width)  * 2 - 1;
  pointerVec.y = -((my / rect.height)) * 2 + 1;
  raycaster.setFromCamera(pointerVec, camera);

  const allMeshes = [...meshToMeta.keys()];
  const hits = raycaster.intersectObjects(allMeshes);

  if (hits.length) {
    const meta = meshToMeta.get(hits[0].object);
    if (!meta) return;

    // Highlight
    if (hoveredTube !== meta.tube) {
      if (hoveredTube) {
        const prev = meshToMeta.get(hoveredTube);
        if (prev) { prev.mat.emissiveIntensity = 0; prev.capMat.emissiveIntensity = 0; }
      }
      hoveredTube = meta.tube;
      meta.mat.emissive    = new Color(0x04a5e5);
      meta.capMat.emissive = new Color(0x04a5e5);
      meta.mat.emissiveIntensity    = 0.30;
      meta.capMat.emissiveIntensity = 0.30;
    }

    if (!isDragging) stage.style.cursor = 'pointer';

    // Tooltip
    tooltip.textContent = meta.title;
    tooltip.style.left    = mx + 'px';
    tooltip.style.top     = my + 'px';
    tooltip.style.opacity = '1';

    // Image scrub: map horizontal position within stage to image index
    if (meta.scrubImages && meta.scrubImages.length > 1) {
      const t     = mx / rect.width;
      const idx   = Math.min(meta.scrubImages.length - 1, Math.floor(t * meta.scrubImages.length));
      const iSrc  = meta.scrubImages[idx];
      if (iSrc && iSrc !== meta._lastScrubSrc) {
        meta._lastScrubSrc = iSrc;
        clearTimeout(scrubTimeout);
        scrubTimeout = setTimeout(() => {
          meta.loader.load(iSrc, (tex) => {
            meta.mat.map     = tex;
            meta.capMat.map  = tex;
            meta.mat.needsUpdate    = true;
            meta.capMat.needsUpdate = true;
          });
        }, 40);
      }
    }
  } else {
    if (hoveredTube) {
      const prev = meshToMeta.get(hoveredTube);
      if (prev) { prev.mat.emissiveIntensity = 0; prev.capMat.emissiveIntensity = 0; }
      hoveredTube = null;
    }
    tooltip.style.opacity = '0';
    if (!isDragging) stage.style.cursor = 'grab';
  }
});

stage.addEventListener('click', () => {
  if (hoveredTube) window.location.href = meshToMeta.get(hoveredTube)?.url || '#';
});

// ── Render loop ───────────────────────────────────────────────────────────────
// Portrait always faces camera (billboard)
function animate() {
  requestAnimationFrame(animate);
  // Billboard: copy camera quaternion so portrait always faces viewer
  portraitMesh.quaternion.copy(camera.quaternion);
  renderer.render(scene, camera);
}

// ── Init ──────────────────────────────────────────────────────────────────────
syncSize();
applyGroupRotation();
animate();

window.addEventListener('resize', syncSize, { passive: true });
</script>

