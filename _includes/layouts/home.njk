---
layout: layouts/base.njk
---
{% if page.url == "/" %}
{% set homeOptions = home | default({}) %}
{% set introductionHeading = homeOptions.introductionHeading | default(profile.headline) %}
{% set introductionText = homeOptions.introductionText | default(profile.aboutBio) %}
{% set featuredProjectThumbnailLimit = homeOptions.featuredProjectThumbnailLimit | default(10) %}
{% set homeContactLinks = homeOptions.contactLinks | default([
  { title: "jonmccon@gmail.com", url: "https://mail.google.com/mail/?view=cm&fs=1&to=jonmccon@gmail.com", icon: "mail", external: true },
  { title: "GitHub", url: "https://github.com/jonmccon", icon: "github" },
  { title: "LinkedIn", url: "https://www.linkedin.com/in/jonmccon", icon: "linkedin" }
]) %}

<section class="homepage-axis-hero" aria-label="Homepage hero">
  <div class="home-axis-stage" data-axis-stage>
    <div class="home-axis-grid" aria-hidden="true">
      <span class="home-axis-line home-axis-line-x"></span>
      <span class="home-axis-line home-axis-line-y"></span>
      <span class="home-axis-line home-axis-line-z"></span>
      <span class="home-axis-origin-point"></span>
      <span class="home-axis-label home-axis-label-x">technology</span>
      <span class="home-axis-label home-axis-label-y">human behavior</span>
      <span class="home-axis-label home-axis-label-z">product strategy</span>
    </div>

    <div class="home-center-lockup">
      {% if introductionHeading %}<h1 class="homepage-headline-axis">{{ introductionHeading }}</h1>{% endif %}
      <div class="homepage-main-avatar homepage-main-avatar-overlay">
        {% image profile.portraitUrl, "Jonny McConnell portrait", [240], "240px" %}
      </div>
    </div>

    {% for post in collections.featuredProjects | reverse %}
    {% if loop.index <= featuredProjectThumbnailLimit %}
    <article class="home-axis-project" data-axis-project data-project-index="{{ loop.index0 }}" data-project-title="{{ post.data.title | slugify }}" data-project-tags="{{ (post.data.tags | filterTagList | join(',')) | lower }}">
      <a class="home-axis-project-link" href="{{ post.url }}" aria-label="{{ post.data.title }}">
        <div class="home-axis-dot">
          {% if post.data.images and post.data.images.length %}
            {% homepageImage post.data.images[0].src, post.data.pageHeadline, 80, "home-axis-dot-img" %}
          {% endif %}
        </div>
        {# Temporarily commented out for performance - will revisit later
        <span class="home-axis-project-title">{{ post.data.pageHeadline }}</span>
        #}
      </a>
    </article>
    {% endif %}
    {% endfor %}
  </div>
</section>

