<script type="importmap">
{
  "imports": {
    "three": "https://esm.sh/three@0.169.0"
  }
}
</script>

<script type="module">
import {
  Scene, PerspectiveCamera, WebGLRenderer,
  CatmullRomCurve3,
  MeshStandardMaterial,
  Mesh,
  LineSegments, BufferGeometry, Float32BufferAttribute, Uint16BufferAttribute,
  LineBasicMaterial,
  AmbientLight, DirectionalLight, PointLight,
  TextureLoader, CanvasTexture,
  Color, Raycaster, Vector2, Vector3,
  Group
} from 'three';

// ── Guard ────────────────────────────────────────────────────────────────────
const stage      = document.querySelector('[data-axis-stage]');
const canvas     = document.querySelector('[data-axis-canvas]');
const projectEls = Array.from(document.querySelectorAll('[data-axis-project]'));
const headlineEl = document.querySelector('[data-chart-headline]');
const headlineH1 = headlineEl ? headlineEl.querySelector('h1') : null;
const bgStrip    = document.querySelector('[data-chart-bg]');
if (!stage || !canvas || !projectEls.length) throw new Error('[axis] missing DOM');

// ── Default headline text ────────────────────────────────────────────────────
const DEFAULT_HEADLINE = headlineH1 ? headlineH1.textContent : '';

// ── Renderer ─────────────────────────────────────────────────────────────────
const renderer = new WebGLRenderer({ canvas, antialias: true, alpha: true });
renderer.setClearColor(0x000000, 0);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

function syncSize() {
  const w = stage.clientWidth;
  const h = stage.clientHeight;
  renderer.setSize(w, h, false);
  camera.aspect = w / h;
  camera.updateProjectionMatrix();
}

// ── Scene + Camera ───────────────────────────────────────────────────────────
const scene  = new Scene();
const camera = new PerspectiveCamera(58, 1, 0.1, 2000);
// More overhead view: higher Y, less Z — matches screenshot reference
camera.position.set(0, 80, 480);
camera.lookAt(0, 0, 0);

// ── Lights ───────────────────────────────────────────────────────────────────
scene.add(new AmbientLight(0xffffff, 0.85));
const sun = new DirectionalLight(0xd0eeff, 0.9);
sun.position.set(1.2, 2, 1.5);
scene.add(sun);
const fill = new PointLight(0x7287fd, 0.6, 1800);
fill.position.set(-220, 140, 340);
scene.add(fill);

// ── Radial chart constants ────────────────────────────────────────────────────
const CAREER_START_YEAR  = 2010;
const CAREER_START_MONTH = 1;
const CAREER_END_YEAR    = 2026;
const CAREER_END_MONTH   = 8;
const CAREER_MONTHS      = (CAREER_END_YEAR - CAREER_START_YEAR) * 12
                           + (CAREER_END_MONTH - CAREER_START_MONTH); // 199

const RADIANS_PER_MONTH = (2 * Math.PI) / CAREER_MONTHS;
const THETA_6OCLOCK     = -Math.PI / 2;   // bottom of clock (−Y axis)

const R_INNER  = 100;   // solo projects radius
const R_OUTER  = 280;   // team projects radius
const Y_RANGE  = 200;   // ± elevation (medium axis depth)
const TUBE_W   = 22;    // ribbon half-width (tangential — arc direction)
const TUBE_H   = 18;    // ribbon half-height (radial — perpendicular to arc plane)
// Together these make a chunky near-square cross-section (44 × 36 units)
const ARC_SEGS = 72;    // arc curve resolution

// ── Ribbon geometry — rounded-rectangle cross-section extruded along arc ──────
// Cross-section is a stadium shape: rectangle(2W × 2H) with semicircular endcaps
// on the H axis. Fully solid stadium endcaps at thetaStart and thetaEnd.
//
// spine[i] = position along curve
// T[i] = tangent, N[i] = curve normal (points toward center), B[i] = T×N (up-ish)
//
// Cross-section profile in local (N, B) space — 8 corners × rounded quadrant:
// cornerSegs = 4 gives 16 profile verts per ring (smooth enough, low poly)
const CORNER_SEGS = 5;   // arc subdivisions per rounded corner

function makeRibbonGeometry(curve, arcSegCount) {
  const totalSpinePoints = arcSegCount + 1;

  // Sample spine positions and Frenet frames
  const positions  = curve.getPoints(arcSegCount);           // Vector3[]
  const tangents   = curve.getTangents(arcSegCount);         // Vector3[]
  // Build binormal by keeping a consistent up reference
  const up = new Vector3(0, 1, 0);
  const frames = tangents.map((T, i) => {
    // Normal = T × up, then re-orthogonalise
    const N = new Vector3().crossVectors(T, up).normalize();
    if (N.lengthSq() < 0.001) {
      // Degenerate (T parallel to up) — use world X
      N.set(1, 0, 0).cross(T).normalize();
    }
    const B = new Vector3().crossVectors(T, N).normalize();
    return { pos: positions[i], T, N, B };
  });

  // Build stadium cross-section profile (in local N-B plane, centred at 0,0)
  // Stadium = rect(-W..W, -H..H) + semicircle caps at ±W on N axis
  const W = TUBE_W, H = TUBE_H;
  const profilePts = [];  // [n, b] pairs
  // Right semicircle (N > 0 side): from B=+H going clockwise to B=-H
  for (let i = 0; i <= CORNER_SEGS; i++) {
    const a = (Math.PI / 2) - (Math.PI * i / CORNER_SEGS);
    profilePts.push([W + H * Math.cos(a), H * Math.sin(a)]);
  }
  // Left semicircle (N < 0 side): from B=-H going clockwise to B=+H
  for (let i = 0; i <= CORNER_SEGS; i++) {
    const a = -(Math.PI / 2) - (Math.PI * i / CORNER_SEGS);
    profilePts.push([-W + H * Math.cos(a), H * Math.sin(a)]);
  }
  const profileCount = profilePts.length;   // 2*(CORNER_SEGS+1)

  // ── Build side wall geometry ──────────────────────────────────────────────
  const verts  = [];
  const normals = [];
  const uvs    = [];
  const indices = [];

  // For each spine point, emit one ring of profile verts
  for (let si = 0; si < totalSpinePoints; si++) {
    const { pos, N, B } = frames[si];
    const u = si / (totalSpinePoints - 1);
    for (let pi = 0; pi < profileCount; pi++) {
      const [pn, pb] = profilePts[pi];
      // World position = spine + N*pn + B*pb
      verts.push(
        pos.x + N.x * pn + B.x * pb,
        pos.y + N.y * pn + B.y * pb,
        pos.z + N.z * pn + B.z * pb
      );
      // Approximate outward normal = N*pn + B*pb, normalised
      const nx = N.x * pn + B.x * pb;
      const ny = N.y * pn + B.y * pb;
      const nz = N.z * pn + B.z * pb;
      const nl = Math.sqrt(nx*nx + ny*ny + nz*nz) || 1;
      normals.push(nx/nl, ny/nl, nz/nl);
      const v = pi / (profileCount - 1);
      uvs.push(u, v);
    }
  }

  // Stitch quads between adjacent spine rings
  for (let si = 0; si < totalSpinePoints - 1; si++) {
    for (let pi = 0; pi < profileCount - 1; pi++) {
      const a = si * profileCount + pi;
      const b = a + 1;
      const c = a + profileCount;
      const d = c + 1;
      indices.push(a, c, b,  b, c, d);
    }
    // Close the loop between last and first profile point
    const a = si * profileCount + (profileCount - 1);
    const b = si * profileCount;
    const c = a + profileCount;
    const d = b + profileCount;
    indices.push(a, c, b,  b, c, d);
  }

  // ── Build endcap geometry (fan triangulation of stadium profile) ──────────
  // Centre of cap = spine endpoint position, normal = ±tangent
  function addCap(frameData, invert) {
    const { pos, T } = frameData;
    const { N, B } = frameData;
    const capCentre = verts.length / 3;
    // Centre vertex
    verts.push(pos.x, pos.y, pos.z);
    const tn = invert ? -1 : 1;
    normals.push(T.x * tn, T.y * tn, T.z * tn);
    uvs.push(0.5, 0.5);

    // Profile ring verts for this cap (same profile, same frame)
    const capStart = verts.length / 3;
    for (let pi = 0; pi < profileCount; pi++) {
      const [pn, pb] = profilePts[pi];
      verts.push(
        pos.x + N.x * pn + B.x * pb,
        pos.y + N.y * pn + B.y * pb,
        pos.z + N.z * pn + B.z * pb
      );
      normals.push(T.x * tn, T.y * tn, T.z * tn);
      const u = 0.5 + pn / (W + H) * 0.5;
      const v = 0.5 + pb / H * 0.5;
      uvs.push(Math.min(1, Math.max(0, u)), Math.min(1, Math.max(0, v)));
    }

    // Fan triangles from centre to each edge of the profile
    for (let pi = 0; pi < profileCount - 1; pi++) {
      if (invert) {
        indices.push(capCentre, capStart + pi + 1, capStart + pi);
      } else {
        indices.push(capCentre, capStart + pi, capStart + pi + 1);
      }
    }
    // Close the loop
    if (invert) {
      indices.push(capCentre, capStart, capStart + profileCount - 1);
    } else {
      indices.push(capCentre, capStart + profileCount - 1, capStart);
    }
  }

  addCap(frames[0], true);                            // start cap
  addCap(frames[totalSpinePoints - 1], false);        // end cap

  // ── Assemble BufferGeometry ───────────────────────────────────────────────
  const geo = new BufferGeometry();
  geo.setAttribute('position', new Float32BufferAttribute(verts, 3));
  geo.setAttribute('normal',   new Float32BufferAttribute(normals, 3));
  geo.setAttribute('uv',       new Float32BufferAttribute(uvs, 2));
  // Use Uint32 if needed (> 65535 verts — for long arcs)
  if (verts.length / 3 > 65535) {
    geo.setIndex(new Float32BufferAttribute(new Uint32Array(indices), 1));
  } else {
    geo.setIndex(indices);
  }
  return geo;
}

// ── Dots texture — rough field of tiny dots, no gloss ────────────────────────
function makeDotsTexture(size = 256) {
  const c = document.createElement('canvas');
  c.width = c.height = size;
  const ctx = c.getContext('2d');
  ctx.fillStyle = '#c8cdd8';
  ctx.fillRect(0, 0, size, size);
  const dotRadius = 1.1;
  const spacing   = 7;
  ctx.fillStyle = 'rgba(80,88,108,0.55)';
  for (let y = spacing / 2; y < size; y += spacing) {
    for (let x = spacing / 2; x < size; x += spacing) {
      ctx.beginPath();
      ctx.arc(x + (Math.random() - 0.5) * 1.5, y + (Math.random() - 0.5) * 1.5, dotRadius, 0, Math.PI * 2);
      ctx.fill();
    }
  }
  return new CanvasTexture(c);
}

const dotsTex = makeDotsTexture(256);

// ── Helper: months since career start ────────────────────────────────────────
function monthsElapsed(dateStr) {
  if (!dateStr) return 0;
  const [y, m] = dateStr.split('-').map(Number);
  return Math.max(0, (y - CAREER_START_YEAR) * 12 + (m - CAREER_START_MONTH));
}

// ── Helper: point on circle at radius r, elevation y, angle theta ─────────
function circlePoint(r, yElev, theta) {
  return new Vector3(r * Math.cos(theta), yElev, r * Math.sin(theta));
}

// ── Helper: build arc curve ───────────────────────────────────────────────
function makeArcCurve(r, yElev, thetaStart, thetaEnd) {
  const pts = [];
  for (let i = 0; i <= ARC_SEGS; i++) {
    const t   = i / ARC_SEGS;
    const ang = thetaStart + t * (thetaEnd - thetaStart);
    pts.push(circlePoint(r, yElev, ang));
  }
  return new CatmullRomCurve3(pts, false, 'catmullrom', 0.0);
}

// ── Axis reference rings ──────────────────────────────────────────────────────
function makeRingVerts(r, segments = 128) {
  const verts = [];
  for (let i = 0; i <= segments; i++) {
    const a  = (i / segments) * 2 * Math.PI;
    const a2 = ((i + 1) / segments) * 2 * Math.PI;
    verts.push(r * Math.cos(a), 0, r * Math.sin(a));
    verts.push(r * Math.cos(a2), 0, r * Math.sin(a2));
  }
  return new Float32Array(verts);
}

const ringMat = new LineBasicMaterial({ color: 0x7287fd, transparent: true, opacity: 0.12 });
for (const r of [R_INNER, (R_INNER + R_OUTER) / 2, R_OUTER]) {
  const rg = new BufferGeometry();
  rg.setAttribute('position', new Float32BufferAttribute(makeRingVerts(r), 3));
  scene.add(new LineSegments(rg, ringMat.clone()));
}

// Career-start tick line
const tickVerts = new Float32Array([0, 0, -R_OUTER * 1.05, 0, 0,  R_OUTER * 1.05]);
const tickGeo   = new BufferGeometry();
tickGeo.setAttribute('position', new Float32BufferAttribute(tickVerts, 3));
scene.add(new LineSegments(tickGeo, new LineBasicMaterial({ color: 0x9ca0b0, transparent: true, opacity: 0.15 })));

// ── Build project arc tubes ───────────────────────────────────────────────────
const meshGroup = new Group();
scene.add(meshGroup);

const loader   = new TextureLoader();
const meshMeta = [];

projectEls.forEach((el) => {
  const dateStr  = el.dataset.chartDate  || '';
  const duration = parseInt(el.dataset.chartDuration      || '6',  10);
  const collab   = parseInt(el.dataset.chartCollaboration || '50', 10) / 100;
  const medium   = parseInt(el.dataset.chartMedium        || '50', 10) / 100;
  const url      = el.dataset.projectUrl   || '#';
  const title    = el.dataset.projectTitle || '';
  const blendSrc = el.dataset.chartBlend   || null;

  // Collect all per-project image URLs for background strip
  let scrubImages = [];
  try { scrubImages = JSON.parse(el.dataset.chartImages || '[]'); } catch(e) {}

  // ── Radial position ──────────────────────────────────────────────────────
  const r      = R_INNER + collab * (R_OUTER - R_INNER);
  const yElev  = (medium - 0.5) * 2 * Y_RANGE;
  const elapsed    = monthsElapsed(dateStr);
  const thetaStart = THETA_6OCLOCK - elapsed     * RADIANS_PER_MONTH;
  const thetaEnd   = thetaStart    - duration    * RADIANS_PER_MONTH;
  const thetaMid   = (thetaStart + thetaEnd) / 2;

  // ── Tube material — rough dots texture, no gloss ──────────────────────────
  // Start with dots texture; blend image loads in on top if available
  const mat = new MeshStandardMaterial({
    map: dotsTex,
    color: 0xd8dce8,
    roughness: 0.95,
    metalness: 0.0,
    transparent: true,
    opacity: 0.92,
  });

  // Load blend image — will replace the dots texture
  if (blendSrc) {
    loader.load(blendSrc, (tex) => {
      mat.map   = tex;
      mat.color.set(0xffffff);
      mat.roughness  = 0.88;
      mat.opacity    = 0.92;
      mat.needsUpdate = true;
    });
  }

  // ── Arc ribbon — full 3D rectangular bar with stadium endcaps ────────────
  const arcSegs = Math.max(16, Math.round(ARC_SEGS * (duration / CAREER_MONTHS)));
  const curve   = makeArcCurve(r, yElev, thetaStart, thetaEnd);
  const geo     = makeRibbonGeometry(curve, arcSegs);
  const tube    = new Mesh(geo, mat);
  tube.userData = { url, title };
  meshGroup.add(tube);

  // Anchor for screen-space tooltip (midpoint above the bar surface)
  const midPt = circlePoint(r, yElev + TUBE_H + 4, thetaMid);
  meshMeta.push({ tube, midPt, url, title, scrubImages, mat, loader });
});

// ── Drag rotation ────────────────────────────────────────────────────────────
let isDragging = false, startX = 0, startY = 0;
let rotX = -15, rotY = 0;  // near-horizontal: slight tilt matching reference screenshot

function applyGroupRotation() {
  const rx = rotX * Math.PI / 180;
  const ry = rotY * Math.PI / 180;
  meshGroup.rotation.set(rx, ry, 0);
  // Also rotate rings and tick lines
  scene.children.forEach(c => {
    if (c instanceof LineSegments) c.rotation.set(rx, ry, 0);
  });
}

stage.addEventListener('mousedown',  e => { isDragging = true; startX = e.clientX; startY = e.clientY; stage.style.cursor = 'grabbing'; });
window.addEventListener('mouseup',   () => { isDragging = false; stage.style.cursor = 'grab'; });
window.addEventListener('mousemove', e => {
  if (!isDragging) return;
  rotY += (e.clientX - startX) * 0.35;
  rotX -= (e.clientY - startY) * 0.35;
  startX = e.clientX; startY = e.clientY;
  applyGroupRotation();
});

stage.addEventListener('touchstart', e => {
  isDragging = true;
  startX = e.touches[0].clientX; startY = e.touches[0].clientY;
}, { passive: true });
window.addEventListener('touchend', () => { isDragging = false; });
stage.addEventListener('touchmove', e => {
  if (!isDragging) return;
  e.preventDefault();
  rotY += (e.touches[0].clientX - startX) * 0.35;
  rotX -= (e.touches[0].clientY - startY) * 0.35;
  startX = e.touches[0].clientX; startY = e.touches[0].clientY;
  applyGroupRotation();
}, { passive: false });

// ── Hover: raycaster + headline update + background strip ─────────────────────
const raycaster  = new Raycaster();
const pointerVec = new Vector2();
let hoveredTube  = null;

// Map tube meshes → metadata
const meshToMeta = new Map();
meshMeta.forEach(m => meshToMeta.set(m.tube, m));

// Update the HTML headline and background strip on hover
function setHoverState(meta) {
  if (headlineH1 && meta) {
    headlineH1.textContent = meta.title;
    headlineH1.setAttribute('data-hovered', 'true');
  }
  if (bgStrip && meta && meta.scrubImages && meta.scrubImages.length) {
    // Build a horizontal strip of stacked images (screenshot 3 style)
    const imgs = meta.scrubImages.slice(0, 8);
    bgStrip.innerHTML = imgs.map(src =>
      `<img src="${src}" alt="" aria-hidden="true" class="home-axis-bg-img">`
    ).join('');
    bgStrip.style.opacity = '1';
    bgStrip.setAttribute('data-active', meta.title);
  }
}

function clearHoverState() {
  if (headlineH1) {
    headlineH1.textContent = DEFAULT_HEADLINE;
    headlineH1.removeAttribute('data-hovered');
  }
  if (bgStrip) {
    bgStrip.style.opacity = '0';
    bgStrip.removeAttribute('data-active');
  }
}

stage.addEventListener('mousemove', e => {
  const rect = stage.getBoundingClientRect();
  const mx   = e.clientX - rect.left;
  const my   = e.clientY - rect.top;
  pointerVec.x =  (mx / rect.width)  * 2 - 1;
  pointerVec.y = -((my / rect.height)) * 2 + 1;
  raycaster.setFromCamera(pointerVec, camera);

  const allMeshes = [...meshToMeta.keys()];
  const hits = raycaster.intersectObjects(allMeshes);

  if (hits.length) {
    const meta = meshToMeta.get(hits[0].object);
    if (!meta) return;

    // Emissive highlight
    if (hoveredTube !== meta.tube) {
      if (hoveredTube) {
        const prev = meshToMeta.get(hoveredTube);
        if (prev) prev.mat.emissiveIntensity = 0;
      }
      hoveredTube = meta.tube;
      meta.mat.emissive = new Color(0x04a5e5);
      meta.mat.emissiveIntensity = 0.28;
      setHoverState(meta);
    }

    if (!isDragging) stage.style.cursor = 'pointer';
  } else {
    if (hoveredTube) {
      const prev = meshToMeta.get(hoveredTube);
      if (prev) prev.mat.emissiveIntensity = 0;
      hoveredTube = null;
      clearHoverState();
    }
    if (!isDragging) stage.style.cursor = 'grab';
  }
});

stage.addEventListener('mouseleave', () => {
  if (hoveredTube) {
    const prev = meshToMeta.get(hoveredTube);
    if (prev) prev.mat.emissiveIntensity = 0;
    hoveredTube = null;
  }
  clearHoverState();
});

stage.addEventListener('click', () => {
  if (hoveredTube) window.location.href = meshToMeta.get(hoveredTube)?.url || '#';
});

// ── Render loop ───────────────────────────────────────────────────────────────
function animate() {
  requestAnimationFrame(animate);
  renderer.render(scene, camera);
}

// ── Init ──────────────────────────────────────────────────────────────────────
syncSize();
applyGroupRotation();
animate();

window.addEventListener('resize', syncSize, { passive: true });
</script>

